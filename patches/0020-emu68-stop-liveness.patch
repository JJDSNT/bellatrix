diff --git a/include/M68k.h b/include/M68k.h
index 7372256..3763beb 100644
--- a/include/M68k.h
+++ b/include/M68k.h
@@ -116,6 +116,13 @@ struct M68KState
     };
     uint64_t INSN_COUNT;
 
+#ifdef BELLATRIX
+    /* Modeled 68k cycles retired by translated instructions. */
+    uint64_t CYCLE_COUNT;
+    /* Architectural STOP state exported to the embedding scheduler. */
+    uint32_t STOPPED;
+#endif
+
     uint32_t JIT_CACHE_MISS;
     uint32_t JIT_UNIT_COUNT;
     uint32_t JIT_CACHE_TOTAL;
diff --git a/src/M68k_LINE4.c b/src/M68k_LINE4.c
index 4ed0d5f..86f28f5 100644
--- a/src/M68k_LINE4.c
+++ b/src/M68k_LINE4.c
@@ -1535,6 +1535,49 @@ static uint32_t *EMIT_STOP(uint32_t *ptr, uint16_t opcode, uint16_t **m68k_ptr,
     *ptr++ = b(2);
     *ptr++ = mov_simd_to_reg(sp, 31, TS_S, 2);  // Load ISP
 
+#ifdef BELLATRIX
+    /* Bellatrix: chipset time is CPU-driven -- the MainLoop BELLATRIX block
+     * advances the chipset between units. Sleeping on wfi/wfe here would
+     * deadlock: single-core Emu68 only advances Rigel's clock (and
+     * therefore VBL, and therefore any interrupt that could wake a real
+     * sleep) from the JIT's own progress hook and the bus-fault path, both
+     * of which require the CPU to still be retiring instructions. This
+     * must stay unconditional -- NOT excluded for
+     * BELLATRIX_EMU68_FAULT_DRIVEN; a later revision added that exclusion
+     * and fell through to the raw wfi() below, which nothing can ever wake.
+     *
+     * While INT is clear, end the unit without advancing PC (leave the
+     * guest still logically stopped) but account this pass as 8 retired
+     * instructions (64 M68K cycles) so the JIT insn counter (v30) -- and
+     * with it Bellatrix chipset time -- keeps flowing at a useful rate: on
+     * real STOP hardware idle time is wall-clock, so any reasonable rate is
+     * semantically fine, but crediting only the true 0 retired instructions
+     * per pass made a QEMU TCG idle frame take minutes. The STOP unit is
+     * simply re-dispatched next MainLoop pass. STOPPED records that PC still
+     * names the STOP instruction. This matters in single-core mode, where
+     * Bellatrix can publish IPL from the progress callback after this unit
+     * returned. Interrupt acceptance must then retire STOP before building
+     * the exception frame, otherwise RTE returns to STOP forever. If INT was
+     * already pending here, retire STOP immediately and clear the marker. */
+    {
+        uint8_t tmpreg = RA_AllocARMRegister(&ptr);
+        uint8_t ctx = RA_GetCTX(&ptr);
+
+        *ptr++ = ldr_offset(ctx, tmpreg, __builtin_offsetof(struct M68KState, INT));
+        *ptr++ = cbnz(tmpreg, 7);
+        *ptr++ = mov_immed_u16(tmpreg, 1, 0);
+        *ptr++ = str_offset(ctx, tmpreg, __builtin_offsetof(struct M68KState, STOPPED));
+        *ptr++ = mov_immed_u16(tmpreg, 8, 0);
+        *ptr++ = fmov_from_reg(0, tmpreg);
+        *ptr++ = vadd_2d(30, 30, 0);
+        *ptr++ = b(4);
+        *ptr++ = mov_immed_u16(tmpreg, 0, 0);
+        *ptr++ = str_offset(ctx, tmpreg, __builtin_offsetof(struct M68KState, STOPPED));
+        *ptr++ = add_immed(REG_PC, REG_PC, 4);
+
+        RA_FreeARMRegister(&ptr, tmpreg);
+    }
+#else
     /* Now do what stop does - wait for interrupt */
     *ptr++ = add_immed(REG_PC, REG_PC, 4);
 
@@ -1568,6 +1611,7 @@ static uint32_t *EMIT_STOP(uint32_t *ptr, uint16_t opcode, uint16_t **m68k_ptr,
 
     RA_FreeARMRegister(&ptr, tmpreg);
 #endif
+#endif /* Bellatrix managed machine mode */
 
     *tmpptr = b(ptr - tmpptr);
 
