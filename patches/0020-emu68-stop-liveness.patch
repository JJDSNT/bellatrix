diff --git a/include/M68k.h b/include/M68k.h
--- a/include/M68k.h
+++ b/include/M68k.h
@@ -116,6 +116,13 @@ struct M68KState
     };
     uint64_t INSN_COUNT;
 
+#ifdef BELLATRIX
+    /* Modeled 68k cycles retired by translated instructions. */
+    uint64_t CYCLE_COUNT;
+    /* Architectural STOP state exported to the embedding scheduler. */
+    uint32_t STOPPED;
+#endif
+
     uint32_t JIT_CACHE_MISS;
     uint32_t JIT_UNIT_COUNT;
     uint32_t JIT_CACHE_TOTAL;
diff --git a/src/M68k_LINE4.c b/src/M68k_LINE4.c
index 4ed0d5f..1fc2b84 100644
--- a/src/M68k_LINE4.c
+++ b/src/M68k_LINE4.c
@@ -1535,6 +1535,24 @@ static uint32_t *EMIT_STOP(uint32_t *ptr, uint16_t opcode, uint16_t **m68k_ptr,
     *ptr++ = b(2);
     *ptr++ = mov_simd_to_reg(sp, 31, TS_S, 2);  // Load ISP
 
+#if defined(BELLATRIX) && \
+    (!defined(BELLATRIX_EMU68_FAULT_DRIVEN) || \
+     !BELLATRIX_EMU68_FAULT_DRIVEN)
+    /* Bellatrix is embedded: STOP yields to its scheduler instead of sleeping
+     * on a physical ARM interrupt. Retire STOP exactly once, leave PC at the
+     * following instruction and publish explicit architectural state. */
+    {
+        uint8_t tmpreg = RA_AllocARMRegister(&ptr);
+        uint8_t ctx = RA_GetCTX(&ptr);
+
+        *ptr++ = mov_immed_u16(tmpreg, 1, 0);
+        *ptr++ = str_offset(ctx, tmpreg,
+                            __builtin_offsetof(struct M68KState, STOPPED));
+        *ptr++ = add_immed(REG_PC, REG_PC, 4);
+
+        RA_FreeARMRegister(&ptr, tmpreg);
+    }
+#else
     /* Now do what stop does - wait for interrupt */
     *ptr++ = add_immed(REG_PC, REG_PC, 4);
 
@@ -1568,6 +1586,7 @@ static uint32_t *EMIT_STOP(uint32_t *ptr, uint16_t opcode, uint16_t **m68k_ptr,
 
     RA_FreeARMRegister(&ptr, tmpreg);
 #endif
+#endif /* Bellatrix managed machine mode */
 
     *tmpptr = b(ptr - tmpptr);
 
