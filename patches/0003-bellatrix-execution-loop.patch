@@ -236,6 +307,64 @@ void MainLoop()
                 SR &= ~SR_IPL;
                 SR |= ((level & 7) << SRB_IPL);
 
+
+#ifdef BELLATRIX
+                {
+                    /* setSR may clobber x18 (M68K PC); save once, restore after setSR. */
+                    uint64_t _x18_save;
+                    asm volatile("mov %0, x18" : "=r"(_x18_save));
+
+#if defined(BELLATRIX_RIGEL_TRACE_BUILD) && BELLATRIX_RIGEL_TRACE_BUILD
+                    {
+                        /* kprintf is ordinary-ABI C: it clobbers x14-x17,
+                         * which hold live M68K D0-D3 here. Printing without a
+                         * full context spill corrupted the interrupted task's
+                         * registers (GfxBase in D2/D3 → vector-table trample,
+                         * boot reboot-loop — ISSUE-0038). Spill/reload around
+                         * the print exactly like the MainLoop report hook. */
+                        uint32_t _old_pc  = (uint32_t)_x18_save;
+                        uint32_t _old_sp  = (uint32_t)sp;
+                        uint32_t _vec_addr = ctx->VBR + (uint32_t)vector;
+                        uint32_t _vec_val  = 0;
+                        asm volatile("ldr %w0, [%1, %2]" : "=r"(_vec_val) : "r"(ctx->VBR), "r"(vector));
+                        M68K_SaveContext(ctx);
+                        kprintf("[EXC-REQ] kind=irq lvl=%d vec=%04x old_pc=%08x old_sr=%04x old_sp=%08x vec_addr=%08x vec_val=%08x\n",
+                                level, (unsigned)vector, _old_pc, (unsigned)SRcopy, _old_sp, _vec_addr, _vec_val);
+                        M68K_LoadContext(getCTX());
+                        asm volatile("mov x18, %0" :: "r"(_x18_save)); /* restore after kprintf */
+                    }
+#endif
+
+                    /* Push exception frame */
+                    asm volatile("strh %w1, [%0, #-8]!":"=r"(sp):"r"(SRcopy),"0"(sp));
+                    asm volatile("str %w1, [%0, #2]"::"r"(sp),"r"(PC));
+                    asm volatile("strh %w1, [%0, #6]"::"r"(sp),"r"(vector));
+
+                    /* Set SR */
+                    setSR(SR);
+                    asm volatile("mov x18, %0" :: "r"(_x18_save)); /* setSR may clobber */
+
+                    /* Get VBR */
+                    vbr = ctx->VBR;
+
+                    /* Load new PC from vector table */
+                    asm volatile("ldr %w0, [%1, %2]":"=r"(PC):"r"(vbr),"r"(vector));
+
+#if defined(BELLATRIX_RIGEL_TRACE_BUILD) && BELLATRIX_RIGEL_TRACE_BUILD
+                    {
+                        /* Same spill/reload requirement as the [EXC-REQ]
+                         * print above — kprintf clobbers live M68K D0-D3. */
+                        uint64_t _x18_new;
+                        asm volatile("mov %0, x18" : "=r"(_x18_new));
+                        M68K_SaveContext(ctx);
+                        kprintf("[EXC-PC] old_pc=%08x new_pc=%08x sr=%04x sp=%08x\n",
+                                (uint32_t)_x18_save, (uint32_t)_x18_new, (unsigned)SR, (uint32_t)sp);
+                        M68K_LoadContext(getCTX());
+                        asm volatile("mov x18, %0" :: "r"(_x18_new)); /* restore after kprintf */
+                    }
+#endif
+                }
+#else
                 /* Push exception frame */
                 asm volatile("strh %w1, [%0, #-8]!":"=r"(sp):"r"(SRcopy),"0"(sp));
                 asm volatile("str %w1, [%0, #2]"::"r"(sp),"r"(PC));
@@ -248,7 +377,8 @@ void MainLoop()
