+    {
+        /* Load m68k context and last used PC counter into temporary register */
         LastPC = getLastPC();
         ctx = getCTX();
 
+#ifdef BELLATRIX
+        /* Advance the Bellatrix chipset on every pass through the loop, not
+         * only on MMIO faults. Without this, guest phases that touch no
+         * unmapped address (RAM-only loops, Wait/STOP idling) freeze chipset
+         * time: no VBL, no CIA, no IPL — hard deadlock (ISSUE-0002 liveness).
+         * Uses the same absolute-v30 accumulator as the vectors.c fault hook,
+         * so the two report paths never double-count.
+         *
+         * The report path is ordinary-ABI C: it clobbers the pinned M68K
+         * registers (x13-x17 are caller-saved) and the JIT SIMD state
+         * (v28-v31 hold INSN_COUNT/CACR/FP flags and are not callee-saved).
+         * Wrap the call in a full context spill/reload, exactly like the
+         * translation-miss path below does around M68K_GetTranslationUnit. */
+        /* The spill/reload is too expensive to pay on every unit dispatch,
+         * so gate it: report once at least 64 instructions retired since the
+         * last report (~512 M68K cycles, about two scanlines of IRQ latency
+         * — the vectors.c fault hook still syncs precisely before MMIO), or
+         * after 64 dispatches without progress (translation misses; a
+         * re-dispatched STOP retires instructions each pass, so idle time
+         * keeps flowing through the delta path). */
+        {
+#if defined(BELLATRIX_TRACE_BUILD) && BELLATRIX_TRACE_BUILD
+            /* Trace builds: fine-grained reports so host-side low-memory
+             * watchers can bracket a writer to within a few instructions. */
+            enum { BELA_REPORT_DELTA = 8 };
+#else
+            enum { BELA_REPORT_DELTA = 64 };
+#endif
+            static uint64_t bela_insn_prev;
+            static uint32_t bela_spins;
+            uint64_t _v30_now, _pc_now, _x12_save;
+            asm volatile("mov %0, v30.d[0]" : "=r"(_v30_now));
+            if (emu68_api_sync_pending() ||
+                (_v30_now - bela_insn_prev) >= (uint64_t)BELA_REPORT_DELTA ||
+                ++bela_spins >= 64u) {
+                bela_insn_prev = _v30_now;
+                bela_spins = 0u;
+                asm volatile("mov %0, x18" : "=r"(_pc_now));
+                /* x12 caches the current translation-unit entry for the
+                 * LastPC==PC fast dispatch. M68K_Save/LoadContext do NOT
+                 * cover it, and -ffixed-x12 does not stop GCC from using
+                 * x12 as prologue/epilogue scratch for large stack frames
+                 * (rigel's compose_line does exactly that — ISSUE-0038:
+                 * AROS checksum loop jumped to x12=0x1200 == frame pitch).
+                 * Save/restore it explicitly, and re-zero v28, which the
+                 * JIT assumes holds zero and is only cleared at MainLoop
+                 * entry. */
+                asm volatile("mov %0, x12" : "=r"(_x12_save));
+                M68K_SaveContext(ctx);
+                bellatrix_emu68_report_jit_progress(_v30_now, (uint32_t)_pc_now);
+                M68K_LoadContext(getCTX());
+                asm volatile("mov x12, %0" :: "r"(_x12_save));
+                asm volatile("mov v28.d[0], xzr");
+                if (emu68_api_dispatch_quantum_progress(_v30_now,
+                                                        (uint32_t)_pc_now))
+                    return;
+            }
+        }
+#endif
+
         /* If (unlikely) there was interrupt pending, check if it needs to be processed */
