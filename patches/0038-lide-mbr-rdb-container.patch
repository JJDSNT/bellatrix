+static LONG ScanNestedRDSK(struct MountData *md, ULONG start, ULONG length)
+{
+	ULONG old_offset = md->blockoffset;
+	ULONG old_limit = md->blocklimit;
+	LONG ret;
+
+	if (!length || start > 0xffffffffUL - old_offset) {
+		return -1;
+	}
+
+	md->blockoffset = old_offset + start;
+	md->blocklimit = length;
+	ret = ScanRDSK(md);
+	md->blockoffset = old_offset;
+	md->blocklimit = old_limit;
+	return ret;
+}
+
+static ULONG read_le32(const UBYTE *p)
+{
+	return (ULONG)p[0] |
+		((ULONG)p[1] << 8) |
+		((ULONG)p[2] << 16) |
+		((ULONG)p[3] << 24);
+}
+
+/* Scan primary MBR entries for the Amiga RDB container type used by Emu68. */
+static LONG ScanMBRRDSK(struct MountData *md)
+{
+	UBYTE entries[4 * 16];
+
+	/* MBR LBAs and partition lengths are expressed in 512-byte sectors. */
+	if (md->blocksize != 512 || !readblock(md->buf, 0, 0xffffffff, md)) {
+		return -1;
+	}
+	if (md->buf[510] != 0x55 || md->buf[511] != 0xaa) {
+		return -1;
+	}
+
+	/* Nested scanning overwrites md->buf, so preserve all four entries. */
+	copymem(entries, md->buf + 446, sizeof(entries));
+	for (UWORD i = 0; i < 4; i++) {
+		const UBYTE *part = entries + i * 16;
+		if (part[4] == 0x76) {
+			ULONG start = read_le32(part + 8);
+			ULONG length = read_le32(part + 12);
+			dbg("MBR RDB container found, start %"PRIu32", length %"PRIu32"\n",
+				start, length);
+			return ScanNestedRDSK(md, start, length);
+		}
+	}
+	return -1;
+}
