 {
@@ -79,6 +94,12 @@
 
 	memset(&eloop, 0, sizeof(eloop));
 
+	eloop.task = FindTask(NULL);
+	eloop.wake_sig = AllocSignal(-1);       /* memset made this 0, a valid
+	                                         * signal number - set it for
+	                                         * real, or to -1 if there is
+	                                         * none to spare */
