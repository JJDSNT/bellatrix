+/*
+ * Wake eloop_run() from another task. A no-op when called by the eloop task
+ * itself (it is about to re-evaluate anyway) or when no signal was available.
+ */
+static void eloop_wake(void)
+{
+	if (eloop.task != NULL && eloop.wake_sig >= 0
+		&& eloop.task != FindTask(NULL))
+		Signal(eloop.task, 1UL << eloop.wake_sig);
+}
+
+
 void eloop_run(void)
 {
 	int i;
-	struct os_time tv, now;
+	struct os_time tv, now, armed;
 	u32 sig_mask, sigs;
 	struct timerequest *cur_timer_req = NULL;
 
+	armed.sec = armed.usec = 0;
+
 	while (!eloop.terminate) {
 		sig_mask = 0;
 
+		/*
+		 * A timeout registered from another task may be nearer than the
+		 * one already in flight - the Scan button asks for one at zero
+		 * seconds. Drop the outstanding request and re-arm, otherwise
+		 * the scan waits for whatever was armed first.
+		 */
+		if (cur_timer_req != NULL && eloop.timeout != NULL
+			&& os_time_before(&eloop.timeout->time, &armed)) {
+			AbortIO((APTR) cur_timer_req);
+			WaitIO((APTR) cur_timer_req);
+			SetSignal(0, 1UL << eloop.timer_port->mp_SigBit);
+			cur_timer_req = NULL;
+		}
+
 		if (eloop.timeout && cur_timer_req == NULL) {
 			/* Send a timer request for the next timeout
 			 * (even if it's already occurred) */
@@ -364,6 +420,7 @@
 				tv.sec;
 			eloop.timer_request->tr_time.tv_micro =
 				tv.usec;
+			armed = eloop.timeout->time;
 			SendIO((APTR) eloop.timer_request);
 			cur_timer_req = eloop.timer_request;
 		}
@@ -371,6 +428,12 @@
 			sig_mask |= 1 << eloop.timer_port->mp_SigBit;
 		}
 
+		/* Always waitable, so a timeout registered by another task
+		 * reaches this loop - and so Wait() is never handed a mask of
+		 * zero, which blocks for ever. */
+		if (eloop.wake_sig >= 0)
+			sig_mask |= 1UL << eloop.wake_sig;
+
 
 		/* Add registered signals to signal mask */
 		for (i = 0; i < eloop.signal_count; i++)
@@ -412,6 +475,11 @@
 {
