From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jaime Dias <jaimejosediasnt@gmail.com>
Date: Tue, 19 Aug 2026 20:10:00 -0300
Subject: [PATCH 44/44] vc4gfx: calibrate the vsync probe against the picture

The takeover works now, and the one thing left failing in the Pi 3 log is
the interrupt that should pace the flips:

    [VC4HVS] vsync: per-bit IRQ probe, vtot=1125
    [VC4HVS] vsync: bit 0 -> 156959 ticks
    [VC4HVS] vsync: bit 1 -> 41769 ticks
    [VC4HVS] vsync: bit 2 -> 42033 ticks
    [VC4HVS] vsync: bit 3 -> 41981 ticks
    [VC4HVS] vsync: bit 4 -> 2 ticks
    ...
    [VC4HVS] vsync: bit 8 -> 3 ticks
    [VC4HVS] vsync: no frame-rate bit found, leaving masked

The answer is in that list. A window of 100000 register reads is two or
three frames long, and bits 4 to 8 tick two or three times: those are the
per-frame bits. The probe rejected them because of how it decided what
per-frame ought to mean -- "the bit that counts most is the line-rate one,
and a frame bit counts vtot times less" -- so it took 156959, divided by
1125, and went looking for something near 139. Nothing is near 139,
because nothing in that list is line rate. Bits 0 to 3 are level-
triggered conditions that re-assert the moment the handler clears them,
so they storm, and calibrating against a storm produces a number with no
relation to the picture.

The HVS already knows how long the window is. DISPSTATX carries the
scanline being composited and it wraps once per frame, so counting wraps
over a window of the same length measures the expectation instead of
inferring it from another interrupt.

Probe downwards, too, and stop at the first match. Any bit that fires
once per frame will do -- the flip only waits for the count to advance --
and the frame-rate bits are the high ones here, so descending order finds
one without ever arming the storming bits at the bottom. A probe that
never arms bit 0 never takes 150000 interrupts to learn nothing, and the
whole calibration ends after two windows instead of ten.
--- a/arch/arm-native/soc/broadcom/2708/hidd/vc4gfx/vc4gfx_hvs.c
+++ b/arch/arm-native/soc/broadcom/2708/hidd/vc4gfx/vc4gfx_hvs.c
@@ -566,9 +566,32 @@
  * PV_VERTA/B gives the expected ratio, so no timer is needed. A short
  * burst of line-rate interrupts is known-survivable (bit 7 ran at
  * 67 kHz for a whole session during bring-up). */
+/* How many frames pass during one probe window? DISPSTATX's scanline
+ * counter wraps once per frame, so counting wraps over a window the same
+ * length as a bit probe gives the expected per-frame tick count directly,
+ * with no assumption about which interrupt bit means what. */
+static ULONG hvs_probe_window_frames(void)
+{
+    ULONG last = hvs_rd(HVS_DISPSTATX(HVS_CHANNEL_HDMI))
+               & HVS_DISPSTATX_LINE_MASK;
+    ULONG frames = 0, i;
+
+    for (i = 0; i < HVS_SPIN_PROBEBIT; i++)
+    {
+        ULONG cur = hvs_rd(HVS_DISPSTATX(HVS_CHANNEL_HDMI))
+                  & HVS_DISPSTATX_LINE_MASK;
+
+        if (cur < last)
+            frames++;
+        last = cur;
+    }
+
+    return frames;
+}
+
 static void hvs_vsync_start(struct vc4_hvs_state *st)
 {
-    ULONG c0, i, b;
+    ULONG c0, i;
 
     if (!st->hvs_VSyncIrq)
     {
@@ -578,51 +601,71 @@
 
     if (!st->hvs_VSyncMask)
     {
-        ULONG rate[10];
         ULONG verta = pv_rd(VC4_PV2_BASE, PV_VERTA);
         ULONG vertb = pv_rd(VC4_PV2_BASE, PV_VERTB);
         ULONG vtot = (verta & 0xffff) + (verta >> 16)
                    + (vertb & 0xffff) + (vertb >> 16);
-        ULONG line_max = 0, expect;
+        ULONG frames, rate;
+        int bit;
 
-        bug("[VC4HVS] vsync: per-bit IRQ probe, vtot=%u\n", vtot);
+        /*
+         * Calibrate the window against the picture, not against another
+         * interrupt bit.
+         *
+         * The previous rule was "the bit that counts most is the line-rate
+         * one, and a frame-rate bit counts vtot times less". On a Pi 3 that
+         * produced 156959 / 41769 / 42033 / 41981 ticks for bits 0-3 and 2 or
+         * 3 ticks for bits 4-8, with vtot = 1125. Nothing there is line rate:
+         * bits 0-3 are level-triggered conditions that re-assert the instant
+         * the handler clears them, so they storm, and the derived expectation
+         * (156959 / 1125 = 139) matched no bit at all. Meanwhile bits 4-8 were
+         * the answer in plain sight -- 2 or 3 ticks over a window that really
+         * is 2 or 3 frames long.
+         *
+         * The HVS knows how long the window is: DISPSTATX carries the
+         * scanline being composited, and it wraps once per frame. Count the
+         * wraps over a window of the same length and the expectation is
+         * measured rather than inferred.
+         */
+        frames = hvs_probe_window_frames();
+        bug("[VC4HVS] vsync: probe window = %u frames (vtot=%u)\n",
+            frames, vtot);
 
-        for (b = 0; b < 10; b++)
+        if (frames < 2)
+        {
+            bug("[VC4HVS] vsync: window too short to calibrate, "
+                "leaving masked\n");
+            return;
+        }
+
+        /*
+         * Probe downwards and stop at the first match. Any bit that fires
+         * once per frame serves -- the flip only waits for the count to
+         * advance -- and on this hardware the frame-rate bits are the high
+         * ones, so descending order finds one before ever arming the
+         * storming bits at the bottom. That is worth more than tidiness: a
+         * probe that never arms bit 0 never takes 150k interrupts to learn
+         * nothing.
+         */
+        for (bit = 9; bit >= 0; bit--)
         {
             c0 = st->hvs_VSyncCount;
-            st->hvs_VSyncMask = 1UL << b;       /* handler counts this bit */
+            st->hvs_VSyncMask = 1UL << bit;     /* handler counts this bit */
             pv_wr(VC4_PV2_BASE, PV_INTSTAT, 0x3ff);
-            pv_wr(VC4_PV2_BASE, PV_INTEN, 1UL << b);
+            pv_wr(VC4_PV2_BASE, PV_INTEN, 1UL << bit);
             for (i = 0; i < HVS_SPIN_PROBEBIT; i++)
                 (void)pv_rd(VC4_PV2_BASE, PV_STAT);     /* pace */
             pv_wr(VC4_PV2_BASE, PV_INTEN, 0);
             pv_wr(VC4_PV2_BASE, PV_INTSTAT, 0x3ff);
-            rate[b] = st->hvs_VSyncCount - c0;
-            bug("[VC4HVS] vsync: bit %u -> %u ticks\n", b, rate[b]);
-        }
-        st->hvs_VSyncMask = 0;
+            rate = st->hvs_VSyncCount - c0;
+            st->hvs_VSyncMask = 0;
+            bug("[VC4HVS] vsync: bit %u -> %u ticks\n", (ULONG)bit, rate);
 
-        for (b = 0; b < 10; b++)
-        {
-            if (rate[b] > line_max)
-                line_max = rate[b];
-        }
-        if (vtot == 0 || line_max < vtot / 4)
-        {
-            bug("[VC4HVS] vsync: probe inconclusive (max %u), leaving masked\n",
-                line_max);
-            return;
-        }
-        expect = line_max / vtot;
-        if (expect == 0)
-            expect = 1;
-
-        for (b = 0; b < 10; b++)
-        {
-            if (rate[b] >= (expect + 1) / 2 && rate[b] <= 2 * expect + 2)
+            if (rate >= (frames + 1) / 2 && rate <= 2 * frames + 2)
             {
-                st->hvs_VSyncMask = 1UL << b;
-                bug("[VC4HVS] vsync: bit %u ticks per frame, using it\n", b);
+                st->hvs_VSyncMask = 1UL << bit;
+                bug("[VC4HVS] vsync: bit %u ticks per frame, using it\n",
+                    (ULONG)bit);
                 break;
             }
         }
--- a/arch/arm-native/soc/broadcom/2708/hidd/vc4gfx/vc4gfx_hvs.h
+++ b/arch/arm-native/soc/broadcom/2708/hidd/vc4gfx/vc4gfx_hvs.h
@@ -54,6 +54,7 @@
 #define HVS_DISPCTRLX_H_SHIFT   0
 #define HVS_DISPBKGNDX(ch)      (0x0044 + 0x10 * (ch))  /* background fill */
 #define HVS_DISPSTATX(ch)       (0x0048 + 0x10 * (ch))  /* line counter etc. */
+#define HVS_DISPSTATX_LINE_MASK 0x1fff  /* scanline currently composited */
 /* DISPBASEX reads as base 15:0 / top 31:16 (words) but the observed
  * windows don't bound the live list heads (ch1 head 1636 vs base 2048)
  * — interpretation unresolved, treat as read-only for now. */
