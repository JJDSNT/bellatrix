gpio: preserve the other pins when selecting a function

GPIOSetFunc() stores this pin's three bits into a GPFSEL register without
reading it first, so the other nine pins the same register selects for are
set to input. Selecting four consecutive pins undoes the first three.

The pins in one register are not unrelated to each other. GPFSEL3 covers
GPIO 30-39: the four PL011 signals the Bluetooth radio is on, and the six
that carry the WiFi SDIO bus. Routing one of those groups through this
function silently unroutes the other.

sdio.resource already works around it -- sdio_gpio_mux() opens GPFSEL3 by
hand and does the read-modify-write itself rather than call the resource that
exists to do exactly that. Fixing it here removes the reason for the next
driver to do the same.

diff --git a/arch/arm-native/soc/broadcom/2708/gpio/gpio_init.c b/arch/arm-native/soc/broadcom/2708/gpio/gpio_init.c
index 59185a4b0a..4480c2dde9 100644
--- a/arch/arm-native/soc/broadcom/2708/gpio/gpio_init.c
+++ b/arch/arm-native/soc/broadcom/2708/gpio/gpio_init.c
@@ -111,6 +111,8 @@ AROS_LH2(void, GPIOSetFunc,
     }
     else if (GPIOBase->gpio_periiobase && (pin <= 53))
     {
+        unsigned int val;
+
         reg = GPFSEL0;
         while (pin >= 10) {
             pin -= 10;
@@ -118,11 +120,18 @@ AROS_LH2(void, GPIOSetFunc,
         }
 
         pin += (pin << 1);
-        func <<= pin;
 
         ObtainSemaphore(&GPIOBase->gpio_Sem);
 
-        *(volatile unsigned int *)reg = AROS_LONG2LE(func);
+        /*
+         * Read-modify-write: one GPFSEL selects the function of ten pins,
+         * three bits each, so a plain store of this pin's field sets the
+         * other nine to input.
+         */
+        val = AROS_LE2LONG(*(volatile unsigned int *)reg);
+        val &= ~(7 << pin);
+        val |= (func & 7) << pin;
+        *(volatile unsigned int *)reg = AROS_LONG2LE(val);
 
         ReleaseSemaphore(&GPIOBase->gpio_Sem);
     }
