From: Bellatrix contributors
Subject: [PATCH] vc4gallium: convert little-endian V3D MMIO

The V3D register block is little-endian.  Direct volatile accesses happened
to work on the original ARM targets, but on m68k they turn IDENT0
0x02443356 into 0x56334402 and make the driver reject version 0x56.

Use the AROS endian helpers for every V3D register read and write, as the
other BCM283x MMIO drivers do.  They compile to no-ops on little-endian
targets and byte-swap on big-endian targets.
---
 arch/arm-native/soc/broadcom/2708/hidd/vc4gallium/vc4_v3d.h | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/arch/arm-native/soc/broadcom/2708/hidd/vc4gallium/vc4_v3d.h b/arch/arm-native/soc/broadcom/2708/hidd/vc4gallium/vc4_v3d.h
index 26dd079fd4..5f071a5786 100644
--- a/arch/arm-native/soc/broadcom/2708/hidd/vc4gallium/vc4_v3d.h
+++ b/arch/arm-native/soc/broadcom/2708/hidd/vc4gallium/vc4_v3d.h
@@ -7,6 +7,7 @@
 #define _VC4_V3D_H
 
 #include <exec/types.h>
+#include <aros/cpu.h>
 
 extern IPTR __arm_periiobase;
 #define ARM_PERIIOBASE __arm_periiobase
@@ -117,8 +118,8 @@ extern IPTR __arm_periiobase;
 #define V3D_IDENT0_VER_SHIFT    24
 #define V3D_IDENT0_VER_MASK     0xFF000000
 
-#define V3D_READ(state, reg)        ((state)->v3d_regs[(reg) / 4])
-#define V3D_WRITE(state, reg, val)  ((state)->v3d_regs[(reg) / 4] = (val))
+#define V3D_READ(state, reg)        AROS_LE2LONG((state)->v3d_regs[(reg) / 4])
+#define V3D_WRITE(state, reg, val)  ((state)->v3d_regs[(reg) / 4] = AROS_LONG2LE(val))
 
 /* CPU address of a VideoCore buffer -> the GPU's uncached bus alias.
  * The VC region is identity-mapped below 1GB by the raspi bootstrap (arm
-- 
2.47.3
