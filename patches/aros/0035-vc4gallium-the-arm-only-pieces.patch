From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jaime Dias <jaimejosediasnt@gmail.com>
Date: Tue, 19 Aug 2026 06:20:00 -0300
Subject: [PATCH 35/36] vc4gallium: the ARM-only pieces, for a driver that now
 builds elsewhere

Three kinds of thing, none of them structural.

**Barriers.** Seven `dsb sy` / `dmb sy` written as inline assembly, in
vc4_galliumclass.c, vc4_init.c and vc4_drm_aros.c. Same trap as patches 0013,
0025, 0027 and 0034: m68k gas parses `dsb` as the MRI define-storage directive
and reports ".space specifies non-absolute value" against a temporary file.
__sync_synchronize() says what was meant and compiles everywhere.

**CP15.** A diagnostic block reads SCTLR and ACTLR through `mrc p15` to
explain an ARM slowdown -- cache, branch predictor and MMU control bits. There
is no counterpart outside ARM, and entering SuperState() for the sake of a
report line would be a real cost for nothing, so it is guarded and the two
values stay zero. The report prints them as zero, which is honest: those fields
describe an ARM host and say nothing about any other.

**A spin hint.** `asm volatile("nop")` as the body of a microsecond delay
loop. The loop reads a hardware timer every pass, so it cannot be optimised
away and the hint bought nothing portable; an empty statement replaces it.

With these the driver builds for m68k-emu68: vc4gallium.hidd, 434K.
---
--- a/arch/arm-native/soc/broadcom/2708/hidd/vc4gallium/vc4_galliumclass.c
+++ b/arch/arm-native/soc/broadcom/2708/hidd/vc4gallium/vc4_galliumclass.c
@@ -69,7 +69,11 @@
 
 /* ---- DMA helpers ---- */
 
-static inline void __gallium_dsb(void) { asm volatile("dsb sy" ::: "memory"); }
+/* A full barrier without naming an ARM instruction: m68k gas reads `dsb` as
+ * the MRI define-storage directive and fails as ".space specifies non-absolute
+ * value". Fifth driver in this tree to hit it -- patches 0013, 0025, 0027 and
+ * the vc4gfx one. __sync_synchronize() is the compiler's own full barrier. */
+static inline void __gallium_dsb(void) { __sync_synchronize(); }
 
 /* BCM system timer ticks at 1 MHz — use it for real microsecond budgets
  * instead of CPU-clock-dependent spin counts. */
@@ -82,7 +86,9 @@
 {
     ULONG start = gallium_now_us();
     while ((gallium_now_us() - start) < usec)
-        asm volatile("nop");
+        ;   /* the body was asm("nop"), a spin hint with no portable spelling
+             * and nothing to do here: the loop already reads a hardware timer
+             * every pass, which is barrier enough against being optimised out */
 }
 
 /*
--- a/arch/arm-native/soc/broadcom/2708/hidd/vc4gallium/vc4_init.c
+++ b/arch/arm-native/soc/broadcom/2708/hidd/vc4gallium/vc4_init.c
@@ -74,7 +74,7 @@
     {
         sd->vblank_waiter_sig = sig;
         /* Publish the sig before the task pointer the IRQ server tests. */
-        __asm__ __volatile__("dmb sy" ::: "memory");
+        __sync_synchronize();
         sd->vblank_waiter = FindTask(NULL);
     }
 
@@ -86,7 +86,7 @@
     if (sig >= 0)
     {
         sd->vblank_waiter = NULL;
-        __asm__ __volatile__("dmb sy" ::: "memory");
+        __sync_synchronize();
         FreeSignal(sig);
     }
     ReleaseSemaphore(&sd->wait_gate);
--- a/arch/arm-native/soc/broadcom/2708/hidd/vc4gallium/vc4_drm_aros.c
+++ b/arch/arm-native/soc/broadcom/2708/hidd/vc4gallium/vc4_drm_aros.c
@@ -891,7 +891,7 @@
      * through the uncached 0xC0000000 alias and would otherwise miss dirty
      * ARM L1 lines, stalling the render thread on FS code fetch. */
     CacheClearE(vaddr, args->size, CACRF_ClearD);
-    asm volatile("dsb sy" ::: "memory");
+    __sync_synchronize();
 
     sd->bo_table[handle].vaddr = vaddr;
     sd->bo_table[handle].bus_addr = GPU_BUS_ADDR(vaddr);
@@ -2431,7 +2431,7 @@
      * hands back the identity vaddr), so they were as pointless to walk as the
      * GPU-only buffers the walk already skipped.
      */
-    asm volatile("dsb sy" ::: "memory");
+    __sync_synchronize();
 
     {
         volatile UBYTE *rb = (volatile UBYTE *)rcl_vaddr;
@@ -2642,7 +2642,7 @@
     v3d->pending_ct1ca = rcl_bus;
     v3d->pending_ct1ea = rcl_bus + rcl_size;
     v3d->pending_render = TRUE;
-    asm volatile("dsb sy" ::: "memory");
+    __sync_synchronize();
 
     V3D_WRITE(v3d, V3D_CT0CA, exec_bus + bin_cl_offset);
     V3D_WRITE(v3d, V3D_CT0EA, exec_bus + bin_cl_offset + bin_cl_out_size);
@@ -2846,19 +2846,29 @@
         t0 = VC4G_NOW_US();
         for (i = 0; i < 65536; i += 4)
             *(volatile ULONG *)((UBYTE *)nc_buf + i) = i;
-        asm volatile("dsb sy" ::: "memory");
+        __sync_synchronize();
         t1 = VC4G_NOW_US();
         us_nc = t1 - t0;
     }
 
     /* Cache/branch-predictor/MMU control bits — a mid-run change here
      * (I-bit 12, Z-bit 11, C-bit 2) would explain a global slowdown. */
+#if defined(__arm__)
     {
         APTR ss = SuperState();
         asm volatile("mrc p15, 0, %0, c1, c0, 0" : "=r"(sctlr));
         asm volatile("mrc p15, 0, %0, c1, c0, 1" : "=r"(actlr));
         UserState(ss);
     }
+#else
+    /*
+     * CP15 c1 is an ARM coprocessor register and has no counterpart
+     * elsewhere; on m68k there is nothing to read and SuperState() for the
+     * sake of it would be a real cost for a diagnostic line. Both stay zero
+     * and the report below prints them as such, which is honest -- the fields
+     * exist to explain an ARM slowdown and say nothing about any other host.
+     */
+#endif
 
     ObtainSemaphore(&sd->mbox_lock);
     sd->mbox_msg[0] = AROS_LE2LONG(8 * 4);
