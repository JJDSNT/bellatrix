From: Bellatrix Project <bellatrix@example.invalid>
Subject: [PATCH] vc4gallium: dump first indexed packets

Log the raw host packet, decoded fields, resolved index address, and final V3D
packet for the first four indexed draws.  This distinguishes packet byte-order
problems from index-buffer content problems without per-frame log traffic.
---
diff --git a/arch/arm-native/soc/broadcom/2708/hidd/vc4gallium/vc4_drm_aros.c b/arch/arm-native/soc/broadcom/2708/hidd/vc4gallium/vc4_drm_aros.c
--- a/arch/arm-native/soc/broadcom/2708/hidd/vc4gallium/vc4_drm_aros.c
+++ b/arch/arm-native/soc/broadcom/2708/hidd/vc4gallium/vc4_drm_aros.c
@@ -1570,6 +1570,26 @@ static ULONG process_bin_cl(struct exec_state *exec,
             put_u32_unaligned(dst + dst_off + 6, exec->current_bo[0] + ib_offset);
             put_u32_unaligned(dst + dst_off + 10, max_index);
 
+            {
+                static ULONG indexed_diag_count;
+                if (indexed_diag_count++ < 4)
+                {
+                    UBYTE *in = src + src_off;
+                    UBYTE *out = dst + dst_off;
+                    bug("[VC4Gallium] indexed: mode=%02x count=%d off=%08x "
+                        "max=%d ib=%08x raw=%02x%02x%02x%02x/%02x%02x%02x%02x/%02x%02x%02x%02x "
+                        "out=%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x\n",
+                        in[1], count, ib_offset, max_index,
+                        exec->current_bo[0] + ib_offset,
+                        in[2], in[3], in[4], in[5],
+                        in[6], in[7], in[8], in[9],
+                        in[10], in[11], in[12], in[13],
+                        out[0], out[1], out[2], out[3], out[4], out[5],
+                        out[6], out[7], out[8], out[9], out[10], out[11],
+                        out[12], out[13]);
+                }
+            }
+
             dst_off += pkt_size;
             src_off += pkt_size;
             continue;
-- 
2.39.5
