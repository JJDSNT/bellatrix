From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jaime Dias <jaimejosediasnt@gmail.com>
Date: Sat, 24 Oct 2026 19:38:43 -0300
Subject: [PATCH] exec: keep the full IntETask on emu68

38dc95623a compacts struct IntETask on every m68k: the CPU accounting
fields (iet_private1/2, iet_LastBusy, iet_LastUsageStamp, iet_QuantumLeft)
and the separate iet_AlertData go, and alert details are kept in the saved
CPU context instead. That suits a classic Amiga, which neither fills those
fields nor has memory to spare.

The emu68 target does fill them: its kernel samples Emu68's counters into
iet_private2 and iet_LastBusy to give every task a CPU share, and it has the
memory. Keep the full structure there, alert context included, rather than
lose the accounting or reuse a context this exec was never checked against.
---
 rom/exec/etask.h | 14 ++++++++++----
 1 file changed, 10 insertions(+), 4 deletions(-)

diff --git a/rom/exec/etask.h b/rom/exec/etask.h
index a9e1aa7fff..9cf2cf6fde 100644
--- a/rom/exec/etask.h
+++ b/rom/exec/etask.h
@@ -41,6 +41,12 @@ struct AlertContext
     } u;
 };
 
+/*
+ * A classic m68k Amiga drops the per-task accounting fields and the separate
+ * alert context to save memory. An emu68 machine keeps them: its kernel
+ * fills iet_CpuUsage from Emu68's counters (arch/m68k-emu68/kernel/
+ * cpuusage.c), and has the memory for the rest.
+ */
 struct IntETask
 {
     struct ETask       iet_ETask;
@@ -48,7 +54,7 @@ struct IntETask
     struct timespec     iet_StartTime;          /* time the task was launched              */
     struct timespec     iet_CpuTime;            /* time the task has spent running         */
     ULONG               iet_CpuUsage;           /* CPU Usage of this task                  */
-#ifndef __mc68000
+#if !defined(__mc68000) || defined(__EMU68__)
     UQUAD               iet_private1;
     UQUAD               iet_private2;
 #endif
@@ -57,7 +63,7 @@ struct IntETask
     UBYTE               iet_AlertFlags;         /* See below                               */
     APTR                iet_AlertLocation;      /* Alert location for crash handler        */
     APTR                iet_AlertStack;         /* Frame pointer for stack backtrace       */
-#ifndef __mc68000
+#if !defined(__mc68000) || defined(__EMU68__)
     struct AlertContext iet_AlertData;          /* Extra data coming with the crash        */
 #endif
 #if defined(__AROSEXEC_SMP__)
@@ -67,7 +73,7 @@ struct IntETask
     cpumask_t           *iet_CpuAffinity;        /* bitmap of cores this task can run on    */
     spinlock_t          *iet_SpinLock;          /* pointer to spinlock task is spinning on */
 #endif
-#ifndef __mc68000
+#if !defined(__mc68000) || defined(__EMU68__)
     /* Last CPU-usage sample, for arches that sweep iet_CpuUsage. */
     UQUAD               iet_LastBusy;           /* iet_private2 at the last sample         */
     UQUAD               iet_LastUsageStamp;     /* when that sample was taken              */
@@ -80,7 +86,7 @@ struct IntETask
 
 #define GetIntETask(task)   ((struct IntETask *)GetETask(task))
 #define IntETask(etask)     ((struct IntETask *)(etask))
-#ifdef __mc68000
+#if defined(__mc68000) && !defined(__EMU68__)
 /* Integer task state lives on the task stack, leaving this context available
  * to retain alert details while the failed task is stopped. */
 #define ETaskAlertData(iet) ((struct AlertContext *)(iet)->iet_ETask.et_RegFrame)
-- 
2.43.0

