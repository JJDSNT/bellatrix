From ef8286b84d447bb45f3408c85f247612629e0061 Mon Sep 17 00:00:00 2001
From: Bellatrix contributors <bellatrix@localhost>
Date: Tue, 25 Aug 2026 11:15:00 -0300
Subject: [PATCH] mesa: align ralloc blocks explicitly

The m68k C ABI does not require malloc to provide Mesa's hard-coded eight-byte
suballocation alignment.  Allocate ralloc headers through Mesa's aligned-memory
helper so the linear allocator's payload alignment does not depend on libc's
natural alignment.
---
 workbench/libs/mesa/mesa-20.0.8-aros.diff | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/workbench/libs/mesa/mesa-20.0.8-aros.diff b/workbench/libs/mesa/mesa-20.0.8-aros.diff
index bdc6631d0c..6b9003be72 100644
--- a/workbench/libs/mesa/mesa-20.0.8-aros.diff
+++ b/workbench/libs/mesa/mesa-20.0.8-aros.diff
@@ -1195,3 +1195,26 @@
  }
  
  static void
+diff -ruN mesa-20.0.8/src/util/ralloc.c mesa-20.0.8.aros/src/util/ralloc.c
+--- mesa-20.0.8/src/util/ralloc.c	2020-06-12 01:21:16.000000000 +0000
++++ mesa-20.0.8.aros/src/util/ralloc.c	2026-08-25 11:15:00.000000000 -0300
+@@ -28,6 +28,7 @@
+ #include <string.h>
+ #include <stdint.h>
+ 
++#include "os_memory.h"
+ /* Some versions of MinGW are missing _vscprintf's declaration, although they
+  * still provide the symbol in the import library. */
+ #ifdef __MINGW32__
+@@ -116,7 +117,8 @@
+ void *
+ ralloc_size(const void *ctx, size_t size)
+ {
+-   void *block = malloc(size + sizeof(ralloc_header));
++   void *block = os_malloc_aligned(size + sizeof(ralloc_header),
++                                   __alignof__(ralloc_header));
+    ralloc_header *info;
+    ralloc_header *parent;
+ 
+@@ -296,7 +298,7 @@
+    if (info->destructor != NULL)
+       info->destructor(PTR_FROM_HEADER(info));
+ 
+-   free(info);
++   os_free_aligned(info);
+ }
+ 
+ void
