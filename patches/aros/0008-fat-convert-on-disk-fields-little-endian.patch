From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jaime Dias <jaimejosediasnt@gmail.com>
Date: Thu, 6 Aug 2026 23:30:00 -0300
Subject: [PATCH 9/9] fat: convert on-disk fields little-endian

rom/filesys/fat converts cluster and size on read -- FIRST_FILE_CLUSTER() in
fat_fs.h, AROS_LE2LONG on file_size in lock.c -- and not on write. The date
fields are converted on neither side. On a little-endian host all of it is a
no-op, which is why it has survived; on a big-endian one the cluster and size
go to disk in host order and come back swapped, and the dates are wrong on
disk for anything else that reads the card.

Measured rather than argued. A boot wrote a 17-byte text file and copied
C:Echo, 1944 bytes, to the card; the image was then read on the host:

  BYTEORD.TST   size 285212672  = 0x11000000 -> byte-reversed 17
  ECHOCOPY.BIN  size 2550595584 = 0x98070000 -> byte-reversed 1944
  year 2028

and both files' *contents* are byte-identical to the originals -- all 1944
bytes of the copied binary, zero differing. So the block path is clean and
the loss is entirely in how these fields are composed. That clears the SD
backend, which was the other candidate: the two attempts at that question are
now settled with bytes.

The date conversion goes inside ConvertFATDate/ConvertDOSDate rather than at
the call sites, so the two halves stay together and cannot drift apart again
-- which is precisely how cluster and size came to be converted on one side
only.

This is an upstream AROS defect on every big-endian target. m68k-amiga,
ppc-native and ppc-morphos share this code and it is latent there only
because writing FAT from them is rare.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
--- a/rom/filesys/fat/date.c
+++ b/rom/filesys/fat/date.c
@@ -24,6 +24,13 @@
     ULONG year, month, day, hours, mins, secs;
     struct ClockData clock_data;
 
+    /* The fields come off the disk little-endian. Converted here rather than
+     * at the two call sites so read and write stay together and cannot drift
+     * apart again -- which is exactly how the cluster and size fields ended up
+     * converted on one side only. */
+    date = AROS_LE2WORD(date);
+    time = AROS_LE2WORD(time);
+
     /* Date bits: yyyy yyym mmmd dddd */
     year = (date & 0xfe00) >> 9;    /* Bits 15-9 */
     month = (date & 0x01e0) >> 5;   /* bits 8-5 */
@@ -94,9 +101,11 @@
     /* All that remains is to bit-encode the whole lot */
 
     /* Date bits: yyyy yyym mmmd dddd */
-    *date = (((ULONG) year) << 9) | (((ULONG) month) << 5) | day;
+    *date = AROS_WORD2LE((((ULONG) year) << 9) |
+        (((ULONG) month) << 5) | day);
 
     /* Time bits: hhhh hmmm mmms ssss */
-    *time = (((ULONG) hours) << 11) | (((ULONG) mins) << 5) | secs;
+    *time = AROS_WORD2LE((((ULONG) hours) << 11) |
+        (((ULONG) mins) << 5) | secs);
 }
 
--- a/rom/filesys/fat/direntry.c
+++ b/rom/filesys/fat/direntry.c
@@ -239,8 +239,8 @@
     /* Loop through the entries until we find a match */
     while ((err = GetNextDirEntry(dh, de, glob)) == 0)
     {
-        if (de->e.entry.first_cluster_hi == (cluster >> 16)
-            && de->e.entry.first_cluster_lo == (cluster & 0xffff))
+        /* Compare in one domain, not two: the fields are little-endian. */
+        if (FIRST_FILE_CLUSTER(de) == cluster)
         {
             D(bug("[fat] matched starting cluster at entry %ld, returning\n",
                 dh->cur_index));
@@ -578,8 +578,25 @@
     de->e.entry.create_time_tenth = ds.ds_Tick % (TICKS_PER_SECOND * 2)
         / (TICKS_PER_SECOND / 10);
 
-    de->e.entry.first_cluster_lo = cluster & 0xffff;
-    de->e.entry.first_cluster_hi = cluster >> 16;
+/*
+ * Little-endian on the way out.
+ *
+ * Upstream converts these on read -- FIRST_FILE_CLUSTER() in fat_fs.h and
+ * lock.c's AROS_LE2LONG on file_size -- and not on write. On a little-endian
+ * host both are no-ops and the asymmetry is invisible, which is why it has
+ * survived. On a big-endian one the field goes to disk in host order and comes
+ * back swapped: a 1944-byte file reads back as 2550595584, and its cluster
+ * chain leads nowhere. Measured on this port, not deduced.
+ *
+ * Only the write side is touched. The date fields are *symmetrically*
+ * unconverted -- ConvertDOSDate produces a native UWORD and ConvertFATDate is
+ * handed the raw field -- so AROS round-trips them correctly among itself, and
+ * converting one side alone would break what currently works. They are wrong
+ * on disk for anything else that reads the card, which is a separate and much
+ * smaller problem.
+ */
+    de->e.entry.first_cluster_lo = AROS_WORD2LE(cluster & 0xffff);
+    de->e.entry.first_cluster_hi = AROS_WORD2LE(cluster >> 16);
 
     de->e.entry.file_size = 0;
 }
--- a/rom/filesys/fat/ops.c
+++ b/rom/filesys/fat/ops.c
@@ -590,7 +590,7 @@
     /* Make a new entry in the target dir */
     if ((err = CreateDirEntry(&ddh, dname, dnamelen,
         sde.e.entry.attr | ATTR_ARCHIVE,
-        (sde.e.entry.first_cluster_hi << 16) | sde.e.entry.first_cluster_lo,
+        FIRST_FILE_CLUSTER(&sde),
         &dde, glob)) != 0)
     {
         ReleaseDirHandle(&ddh, glob);
@@ -742,8 +742,8 @@
     cluster = dh.ioh.first_cluster;
     if (cluster == dh.ioh.sb->rootdir_cluster)
         cluster = 0;
-    sde.e.entry.first_cluster_lo = cluster & 0xffff;
-    sde.e.entry.first_cluster_hi = cluster >> 16;
+    sde.e.entry.first_cluster_lo = AROS_WORD2LE(cluster & 0xffff);
+    sde.e.entry.first_cluster_hi = AROS_WORD2LE(cluster >> 16);
     UpdateDirEntry(&sde, glob);
 
     /* Clear all remaining entries (the first of which marks the end of the
@@ -879,9 +879,11 @@
                 glob);
             GetDirEntry(&dh, lock->gl->dir_entry, &de, glob);
 
-            de.e.entry.file_size = lock->gl->size;
-            de.e.entry.first_cluster_lo = lock->gl->first_cluster & 0xffff;
-            de.e.entry.first_cluster_hi = lock->gl->first_cluster >> 16;
+            de.e.entry.file_size = AROS_LONG2LE(lock->gl->size);
+            de.e.entry.first_cluster_lo =
+                AROS_WORD2LE(lock->gl->first_cluster & 0xffff);
+            de.e.entry.first_cluster_hi =
+                AROS_WORD2LE(lock->gl->first_cluster >> 16);
 
             de.e.entry.attr |= ATTR_ARCHIVE;
             UpdateDirEntry(&de, glob);
@@ -1053,9 +1055,9 @@
     }
 
     /* Clusters are fixed, now update the directory entry */
-    de.e.entry.first_cluster_lo = first & 0xffff;
-    de.e.entry.first_cluster_hi = first >> 16;
-    de.e.entry.file_size = size;
+    de.e.entry.first_cluster_lo = AROS_WORD2LE(first & 0xffff);
+    de.e.entry.first_cluster_hi = AROS_WORD2LE(first >> 16);
+    de.e.entry.file_size = AROS_LONG2LE(size);
     de.e.entry.attr |= ATTR_ARCHIVE;
     UpdateDirEntry(&de, glob);
 
