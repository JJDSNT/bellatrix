diff --git a/arch/m68k-all/exec/preserveall.S b/arch/m68k-all/exec/preserveall.S
new file mode 100644
index 0000000000..5e07c35b37
--- /dev/null
+++ b/arch/m68k-all/exec/preserveall.S
@@ -0,0 +1,28 @@
+/*
+ * m68k Exec ABI wrappers for calls documented to preserve scratch registers.
+ *
+ * The C implementations use the normal AROS register-clobber convention.
+ * Classic m68k callers, however, rely on these Exec vectors preserving
+ * D0-D1/A0-A1.
+ */
+
+#include "aros/m68k/asm.h"
+
+#undef ObtainSemaphore
+#undef ReleaseSemaphore
+
+        .text
+        .balign 4
+
+#define PRESERVE_ALL_WRAPPER(wrapper, function, vector) \
+        .globl wrapper;                                 \
+wrapper:                                                \
+        movem.l %d0-%d1/%a0-%a1,%sp@-;                 \
+        jsr AROS_SLIB_ENTRY(function,Exec,vector);       \
+        movem.l %sp@+,%d0-%d1/%a0-%a1;                 \
+        rts
+
+PRESERVE_ALL_WRAPPER(m68k_Exec_Permit, Permit, 23)
+PRESERVE_ALL_WRAPPER(m68k_Exec_ObtainSemaphore, ObtainSemaphore, 94)
+PRESERVE_ALL_WRAPPER(m68k_Exec_ReleaseSemaphore, ReleaseSemaphore, 95)
+PRESERVE_ALL_WRAPPER(m68k_Exec_ObtainSemaphoreShared, ObtainSemaphoreShared, 113)
diff --git a/arch/m68k-all/exec/preserveall_install.c b/arch/m68k-all/exec/preserveall_install.c
new file mode 100644
index 0000000000..65c9d645e7
--- /dev/null
+++ b/arch/m68k-all/exec/preserveall_install.c
@@ -0,0 +1,23 @@
+/*
+ * Install the register-preserving Exec vector wrappers required by the
+ * classic m68k library ABI. Bootstraps call this after ExecBase is complete.
+ */
+
+#include <exec/execbase.h>
+#include <defines/exec_LVO.h>
+
+extern void m68k_Exec_Permit(void);
+extern void m68k_Exec_ObtainSemaphore(void);
+extern void m68k_Exec_ReleaseSemaphore(void);
+extern void m68k_Exec_ObtainSemaphoreShared(void);
+
+void m68k_ExecInstallPreserveAll(struct ExecBase *SysBase)
+{
+    __AROS_SETVECADDR(SysBase, LVOPermit, m68k_Exec_Permit);
+    __AROS_SETVECADDR(SysBase, LVOObtainSemaphore,
+                     m68k_Exec_ObtainSemaphore);
+    __AROS_SETVECADDR(SysBase, LVOReleaseSemaphore,
+                     m68k_Exec_ReleaseSemaphore);
+    __AROS_SETVECADDR(SysBase, LVOObtainSemaphoreShared,
+                     m68k_Exec_ObtainSemaphoreShared);
+}
diff --git a/arch/m68k-all/exec/signal_fast.S b/arch/m68k-all/exec/signal_fast.S
index 3cc604cd63..0de5b0a7b6 100644
--- a/arch/m68k-all/exec/signal_fast.S
+++ b/arch/m68k-all/exec/signal_fast.S
@@ -27,7 +27,9 @@ AROS_SLIB_ENTRY(Signal,Exec,54):
         and.l   tc_SigWait(%a1),%d1
 
         /* Protect signal fields and the scheduler lists. */
+#ifndef __EMU68__
         move.w  #0x4000,0xdff09a
+#endif
         addq.b  #1,IDNestCnt(%a6)
         cmp.l   tc_SigRecvd(%a1),%a0
         bne     .slow
@@ -79,7 +81,9 @@ AROS_SLIB_ENTRY(Signal,Exec,54):
         ble.s   .done
         bset.b  #7,AttnResched+1(%a6)
         bne.s   .done
+#ifndef __EMU68__
         move.w  #0x8004,0xdff09c
+#endif
         bra.s   .done
 
 .signal_only:
@@ -87,17 +91,21 @@ AROS_SLIB_ENTRY(Signal,Exec,54):
 
 .done:
         subq.b  #1,IDNestCnt(%a6)
+#ifndef __EMU68__
         bpl.s   .return
         move.w  #0xc000,0xdff09a
+#endif
 .return:
         rts
 
 .slow:
         /* Undo our Disable() nesting before entering the original C path. */
         subq.b  #1,IDNestCnt(%a6)
+#ifndef __EMU68__
         bpl.s   1f
         move.w  #0xc000,0xdff09a
 1:
+#endif
 .slow_unlocked:
         move.l  %a6,%sp@-
         move.l  %d0,%sp@-
diff --git a/arch/m68k-all/exec/switch.S b/arch/m68k-all/exec/switch.S
index 028a5d260a..795549170f 100644
--- a/arch/m68k-all/exec/switch.S
+++ b/arch/m68k-all/exec/switch.S
@@ -51,7 +51,9 @@ m68k_VoluntarySwitch:
          * enabled.  Only the signal recheck and scheduler-list commit below
          * form the critical section.
          */
+#ifndef __EMU68__
         move.w  #0x4000,0xdff09a
+#endif
         move.l  ThisTask(%a6),%a0
         move.b  %d3,%d1
         addq.b  #1,%d1
@@ -76,7 +78,9 @@ m68k_VoluntarySwitch:
         move.l  %a5,tc_SPReg(%a0)
         move.b  %d1,tc_IDNestCnt(%a0)
         move.b  #-1,IDNestCnt(%a6)
+#ifndef __EMU68__
         move.w  #0xc000,0xdff09a
+#endif
         jmp     __Dispatch_this
 
 1:
diff --git a/arch/m68k-all/exec/wait.S b/arch/m68k-all/exec/wait.S
index 15aee6ccc9..6b7fd36e82 100644
--- a/arch/m68k-all/exec/wait.S
+++ b/arch/m68k-all/exec/wait.S
@@ -20,7 +20,9 @@ AROS_SLIB_ENTRY(Wait,Exec,53):
          * Keep the immediate-signal case cheap.  The original nesting value
          * remains in D3 across a context switch.
          */
+#ifndef __EMU68__
         move.w  #0x4000,0xdff09a
+#endif
         move.b  %d3,%d1
         addq.b  #1,%d1
         move.b  %d1,IDNestCnt(%a6)
@@ -32,10 +34,12 @@ AROS_SLIB_ENTRY(Wait,Exec,53):
 
         /* Reopen interrupts before the trap and context save. */
         move.b  %d3,IDNestCnt(%a6)
+#ifndef __EMU68__
         tst.b   %d3
         bpl.s   2f
         move.w  #0xc000,0xdff09a
 2:
+#endif
 
         lea.l   m68k_VoluntarySwitch,%a5
         jsr     Supervisor(%a6)
@@ -49,10 +53,12 @@ AROS_SLIB_ENTRY(Wait,Exec,53):
 
         /* Restore the caller's interrupt nesting state. */
         move.b  %d3,IDNestCnt(%a6)
+#ifndef __EMU68__
         tst.b   %d3
         bpl.s   4f
         move.w  #0xc000,0xdff09a
 4:
+#endif
         movem.l %sp@+,%d2-%d3/%a2-%a3/%a5
         rts
         .endfunc
