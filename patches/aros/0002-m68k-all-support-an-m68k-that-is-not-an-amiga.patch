+     */
+    __asm__ volatile(".word 0xf498" ::: "memory");
+    return;
+#endif
+
     if (SysBase->LibNode.lib_OpenCnt == 0)
         /* We were called from PrepareExecBase. AttnFlags isn't set yet.
          * Do nothing or we would always install 68000 routine.
