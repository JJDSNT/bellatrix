 arch/m68k-all/exec/cacheclearu.c         |  9 ++++++++
 arch/m68k-all/exec/dispatch.S            |  2 ++
 arch/m68k-all/exec/mmakefile.src         |  3 ++-
 arch/m68k-all/exec/preserveall.S         | 28 ++++++++++++++++++++++++
 arch/m68k-all/exec/preserveall_install.c | 23 +++++++++++++++++++
 arch/m68k-all/exec/signal_fast.S         |  8 +++++++
 arch/m68k-all/exec/switch.S              |  4 ++++
 arch/m68k-all/exec/wait.S                |  6 +++++
 arch/m68k-all/kernel/kernel_cpu.c        |  4 ++++
 10 files changed, 97 insertions(+), 2 deletions(-)
