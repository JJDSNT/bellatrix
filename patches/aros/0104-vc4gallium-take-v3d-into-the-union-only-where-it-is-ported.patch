From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jaime Dias <jaimejosediasnt@gmail.com>
Date: Sat, 24 Oct 2026 15:45:00 -0300
Subject: [PATCH] vc4gallium: take v3d into the union only where it is ported

a83fcc555b ported v3d to Mesa 26 and, in doing so, replaced its Mesa 20.x
glue and dropped the version gate 860b77190d had put on it. vc4's
GalliumCoreAPI union still takes libgallium_v3d.a and depends on it
unconditionally, so a vc4 build for Mesa 20.0.8 -- which this file still
supports, see GCA_PRIVATE_DATA -- now builds v3d from Mesa 26's XML and
stops at "No rule to make target .../src/broadcom/cle/vc4_packet.xml".

Gate it per Mesa version, the way 860b77190d did: v3d joins the union, and
the dependency, wherever it is not 20.0.8.
---
diff --git a/arch/arm-native/soc/broadcom/2708/hidd/vc4gallium/mmakefile.src b/arch/arm-native/soc/broadcom/2708/hidd/vc4gallium/mmakefile.src
--- a/arch/arm-native/soc/broadcom/2708/hidd/vc4gallium/mmakefile.src
+++ b/arch/arm-native/soc/broadcom/2708/hidd/vc4gallium/mmakefile.src
@@ -228,11 +228,17 @@
 # the union of their import sets. A driver added here must also appear in
 # the v3d-side consumption (hidd/v3d) and vice versa.
 # Both drivers are in the union: upstream gates v3d to 20.0.8, this tree ports
-# it to 26 (see hidd/v3d).
-GCA_CONSUMERS := $(top_libdir)/libgallium_vc4.a $(top_libdir)/libgallium_v3d.a
+# it to 26 (see hidd/v3d). That port replaced the 20.x glue, so a Mesa 20.0.8
+# build -- still selectable with --with-mesagl -- has no v3d to take the union
+# over. Hook it in per Mesa version, as 860b77190d did the other way round.
+GCA_CONSUMERS := $(top_libdir)/libgallium_vc4.a
+ifneq ($(OPT_MESAGL),20.0.8)
+GCA_CONSUMERS += $(top_libdir)/libgallium_v3d.a
+endif
 
-#MM linklibs-gallium_vc4-gca : linklibs-gallium_v3d
-#MM linklibs-galliumcoreapi : linklibs-gallium_vc4 linklibs-gallium_v3d
+#MM- linklibs-gallium_v3d-mesa26.0.0 : linklibs-gallium_v3d
+#MM linklibs-gallium_vc4-gca : linklibs-gallium_v3d-mesa$(OPT_MESAGL)
+#MM linklibs-galliumcoreapi : linklibs-gallium_vc4 linklibs-gallium_v3d-mesa$(OPT_MESAGL)
 
 # The data the driver reads rather than calls, which the glue carries as
 # objects instead of trampolines. Every data import has to be named here or
