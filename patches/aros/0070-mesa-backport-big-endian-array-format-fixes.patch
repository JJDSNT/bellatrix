From: Bellatrix contributors
Subject: [PATCH] mesa: backport big-endian array-format fixes

Mesa 20.0.8 aborts while converting a packed three-byte format on a
big-endian host. Mesa 20.1 fixed this by leaving three-channel formats alone:
there is no same-sized integer type whose channel order can be flipped.

Also backport the later seventh swizzle-table entry fix, which prevents an
out-of-bounds access when the NONE swizzle is present.
---
 workbench/libs/mesa/mesa-20.0.8-aros.diff | 25 ++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/workbench/libs/mesa/mesa-20.0.8-aros.diff b/workbench/libs/mesa/mesa-20.0.8-aros.diff
index d2f0903710..12933275fe 100644
--- a/workbench/libs/mesa/mesa-20.0.8-aros.diff
+++ b/workbench/libs/mesa/mesa-20.0.8-aros.diff
@@ -1299 +1299,26 @@
 +#endif
+diff -ruN mesa-20.0.8/src/mesa/main/formats.c mesa-20.0.8.aros/src/mesa/main/formats.c
+--- mesa-20.0.8/src/mesa/main/formats.c	2020-06-12 01:21:16.000000000 +0000
++++ mesa-20.0.8.aros/src/mesa/main/formats.c	2026-08-25 18:10:00.000000000 -0300
+@@ -404,7 +404,7 @@
+    num_channels = _mesa_array_format_get_num_channels(format);
+    _mesa_array_format_get_swizzle(format, swizzle);
+ 
+-   if (num_channels == 1)
++   if (num_channels == 1 || num_channels == 3)
+       return format;
+ 
+    if (num_channels == 2) {
+@@ -412,7 +412,7 @@
+       for (unsigned i = 0; i < 4; i++)
+          assert(swizzle[i] != 2 && swizzle[i] != 3);
+ 
+-      static const uint8_t flip_xy[6] = { 1, 0, 2, 3, 4, 5 };
++      static const uint8_t flip_xy[7] = { 1, 0, 2, 3, 4, 5, 6 };
+       _mesa_array_format_set_swizzle(&format,
+                                      flip_xy[swizzle[0]], flip_xy[swizzle[1]],
+                                      flip_xy[swizzle[2]], flip_xy[swizzle[3]]);
+@@ -420,7 +420,7 @@
+    }
+ 
+    if (num_channels == 4) {
+-      static const uint8_t flip[6] = { 3, 2, 1, 0, 4, 5 };
++      static const uint8_t flip[7] = { 3, 2, 1, 0, 4, 5, 6 };
+       _mesa_array_format_set_swizzle(&format,
+                                      flip[swizzle[0]], flip[swizzle[1]],
+                                      flip[swizzle[2]], flip[swizzle[3]]);
-- 
2.47.3
