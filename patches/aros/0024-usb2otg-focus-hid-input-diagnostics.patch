From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jaime Dias <jaimejosediasnt@gmail.com>
Date: Fri, 14 Aug 2026 17:20:00 -0300
Subject: [PATCH 24/24] usb2otg: focus HID input diagnostics

The broad device/core DEBUG switches used during controller bring-up print on
every Poseidon submission and materially distort system performance.  Reset,
enumeration and interrupt scheduling now work, so return those files to their
normal quiet setting.

Keep one narrow diagnostic at interrupt completion.  Log the first four bytes
only for a non-zero report, which distinguishes lost mouse motion bytes from a
problem in the HID/input layer without flooding the idle path.
---
 .../broadcom/2708/usb/usb2otg/usb2otg_core.c   |  2 +-
 .../broadcom/2708/usb/usb2otg/usb2otg_device.c | 20 +++++++++++++++++++-
 2 files changed, 20 insertions(+), 2 deletions(-)

diff --git a/arch/arm-native/soc/broadcom/2708/usb/usb2otg/usb2otg_core.c b/arch/arm-native/soc/broadcom/2708/usb/usb2otg/usb2otg_core.c
index 6666666666..7777777777 100644
--- a/arch/arm-native/soc/broadcom/2708/usb/usb2otg/usb2otg_core.c
+++ b/arch/arm-native/soc/broadcom/2708/usb/usb2otg/usb2otg_core.c
@@ -2,7 +2,7 @@
     Copyright (C) 2013-2026, The AROS Development Team. All rights reserved.
 */
 
-#define DEBUG 1
+#define DEBUG 0
 #include <aros/debug.h>
 
 #include <proto/exec.h>
@@ -503,6 +503,24 @@ void FNAME_DEV(TermIO)(struct IOUsbHWReq *ioreq,
         }
     }
 
+    if (ioreq->iouh_Req.io_Command == UHCMD_INTXFER &&
+        ioreq->iouh_Req.io_Error == 0 && ioreq->iouh_Actual != 0 &&
+        ioreq->iouh_Data != NULL)
+    {
+        UBYTE *data = (UBYTE *)ioreq->iouh_Data;
+        UBYTE b0 = ioreq->iouh_Actual > 0 ? data[0] : 0;
+        UBYTE b1 = ioreq->iouh_Actual > 1 ? data[1] : 0;
+        UBYTE b2 = ioreq->iouh_Actual > 2 ? data[2] : 0;
+        UBYTE b3 = ioreq->iouh_Actual > 3 ? data[3] : 0;
+
+        if (b0 != 0 || b1 != 0 || b2 != 0 || b3 != 0)
+            bug("[USB2OTG:HID] dev=%u ep=%u actual=%lu data=%02x %02x %02x %02x\n",
+                (unsigned)ioreq->iouh_DevAddr,
+                (unsigned)ioreq->iouh_Endpoint,
+                (unsigned long)ioreq->iouh_Actual,
+                (unsigned)b0, (unsigned)b1, (unsigned)b2, (unsigned)b3);
+    }
+
     ioreq->iouh_Req.io_Message.mn_Node.ln_Type = NT_FREEMSG;
 
     if (!(ioreq->iouh_Req.io_Flags & IOF_QUICK))
diff --git a/arch/arm-native/soc/broadcom/2708/usb/usb2otg/usb2otg_device.c b/arch/arm-native/soc/broadcom/2708/usb/usb2otg/usb2otg_device.c
index 7777777777..8888888888 100644
--- a/arch/arm-native/soc/broadcom/2708/usb/usb2otg/usb2otg_device.c
+++ b/arch/arm-native/soc/broadcom/2708/usb/usb2otg/usb2otg_device.c
@@ -2,7 +2,7 @@
     Copyright (C) 2013-2026, The AROS Development Team. All rights reserved.
 */
 
-#define DEBUG 1
+#define DEBUG 0
 #include <aros/debug.h>
 #include <aros/atomic.h>
 
