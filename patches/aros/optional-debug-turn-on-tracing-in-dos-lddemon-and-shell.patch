index f024bb2cea..8c605126c9 100644
--- a/rom/dos/newcliproc.c
+++ b/rom/dos/newcliproc.c
@@ -4,6 +4,7 @@
     Desc:
 */
 
+#define DEBUG 1
 #include <aros/debug.h>
 
 #include <dos/dos.h>
