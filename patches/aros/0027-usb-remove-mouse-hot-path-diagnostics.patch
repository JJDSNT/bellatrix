From: Bellatrix Development <bellatrix@localhost>
Subject: [PATCH] usb: remove mouse hot-path diagnostics

The controller and HID-to-input boundary traces established that reports
cross the complete stack correctly.  Remove them now: serial formatting and
output on every movement materially distort the performance measurements the
instrumentation was meant to support.

---
 arch/arm-native/soc/broadcom/2708/usb/usb2otg/usb2otg_core.c | 18 ------------------
 rom/usb/classes/bootmouse/bootmouse.class.c                   | 15 +--------------
 rom/usb/classes/hid/hid.class.c                               |  7 -------
 3 files changed, 1 insertion(+), 40 deletions(-)

diff --git a/arch/arm-native/soc/broadcom/2708/usb/usb2otg/usb2otg_core.c b/arch/arm-native/soc/broadcom/2708/usb/usb2otg/usb2otg_core.c
--- a/arch/arm-native/soc/broadcom/2708/usb/usb2otg/usb2otg_core.c
+++ b/arch/arm-native/soc/broadcom/2708/usb/usb2otg/usb2otg_core.c
@@ -503,24 +503,6 @@ void FNAME_DEV(TermIO)(struct IOUsbHWReq *ioreq,
         }
     }
 
-    if (ioreq->iouh_Req.io_Command == UHCMD_INTXFER &&
-        ioreq->iouh_Req.io_Error == 0 && ioreq->iouh_Actual != 0 &&
-        ioreq->iouh_Data != NULL)
-    {
-        UBYTE *data = (UBYTE *)ioreq->iouh_Data;
-        UBYTE b0 = ioreq->iouh_Actual > 0 ? data[0] : 0;
-        UBYTE b1 = ioreq->iouh_Actual > 1 ? data[1] : 0;
-        UBYTE b2 = ioreq->iouh_Actual > 2 ? data[2] : 0;
-        UBYTE b3 = ioreq->iouh_Actual > 3 ? data[3] : 0;
-
-        if (b0 != 0 || b1 != 0 || b2 != 0 || b3 != 0)
-            bug("[USB2OTG:HID] dev=%u ep=%u actual=%lu data=%02x %02x %02x %02x\n",
-                (unsigned)ioreq->iouh_DevAddr,
-                (unsigned)ioreq->iouh_Endpoint,
-                (unsigned long)ioreq->iouh_Actual,
-                (unsigned)b0, (unsigned)b1, (unsigned)b2, (unsigned)b3);
-    }
-
     ioreq->iouh_Req.io_Message.mn_Node.ln_Type = NT_FREEMSG;
 
     if (!(ioreq->iouh_Req.io_Flags & IOF_QUICK))
diff --git a/rom/usb/classes/bootmouse/bootmouse.class.c b/rom/usb/classes/bootmouse/bootmouse.class.c
--- a/rom/usb/classes/bootmouse/bootmouse.class.c
+++ b/rom/usb/classes/bootmouse/bootmouse.class.c
@@ -482,7 +482,6 @@ AROS_UFH0(void, nHidTask)
     UBYTE *buf;
     UBYTE *bufreal;
     LONG ioerr;
-    LONG inputerr;
     BOOL firstpkt = TRUE;
 
     if((nch = nAllocHid()))
@@ -587,19 +586,7 @@ AROS_UFH0(void, nHidTask)
                         nch->nch_InpIOReq->io_Data = &nch->nch_FakeEvent;
                         nch->nch_InpIOReq->io_Length = sizeof(struct InputEvent);
                         nch->nch_InpIOReq->io_Command = IND_WRITEEVENT;
-                        if(nch->nch_FakeEvent.ie_X != 0 ||
-                           nch->nch_FakeEvent.ie_Y != 0)
-                            bug("[BOOTMOUSE] submit x=%ld y=%ld code=%04lx qual=%04lx raw=%02lx %02lx %02lx %02lx\n",
-                                (LONG)nch->nch_FakeEvent.ie_X,
-                                (LONG)nch->nch_FakeEvent.ie_Y,
-                                (ULONG)nch->nch_FakeEvent.ie_Code,
-                                (ULONG)nch->nch_FakeEvent.ie_Qualifier,
-                                (ULONG)bufreal[0], (ULONG)bufreal[1],
-                                (ULONG)bufreal[2], (ULONG)bufreal[3]);
-                        inputerr = DoIO((struct IORequest *) nch->nch_InpIOReq);
-                        if((nch->nch_FakeEvent.ie_X != 0 ||
-                            nch->nch_FakeEvent.ie_Y != 0) && inputerr != 0)
-                            bug("[BOOTMOUSE] IND_WRITEEVENT failed: %ld\n", inputerr);
+                        DoIO((struct IORequest *) nch->nch_InpIOReq);
                         if(newmouse)
                         {
                             while(wheeldist--)
diff --git a/rom/usb/classes/hid/hid.class.c b/rom/usb/classes/hid/hid.class.c
--- a/rom/usb/classes/hid/hid.class.c
+++ b/rom/usb/classes/hid/hid.class.c
@@ -6425,13 +6425,6 @@ void nFlushEvents(struct NepClassHid *nch)
         nch->nch_InpIOReq->io_Data = &nch->nch_FakeEvent;
         nch->nch_InpIOReq->io_Length = sizeof(struct InputEvent);
         nch->nch_InpIOReq->io_Command = nch->nch_OS4Hack ? IND_ADDEVENT : IND_WRITEEVENT;
-        bug("[HID:MOUSE] submit x=%ld y=%ld code=%04lx qual=%04lx cmd=%lu\n",
-            (LONG)nch->nch_FakeEvent.ie_X, (LONG)nch->nch_FakeEvent.ie_Y,
-            (ULONG)nch->nch_FakeEvent.ie_Code,
-            (ULONG)nch->nch_FakeEvent.ie_Qualifier,
-            (ULONG)nch->nch_InpIOReq->io_Command);
         DoIO((struct IORequest *) nch->nch_InpIOReq);
-        if(ioerr != 0)
-            bug("[HID:MOUSE] input.device failed: %ld\n", ioerr);
         nch->nch_NewMouseRel = FALSE;
         nch->nch_MouseDeltaX = 0;
         nch->nch_MouseDeltaY = 0;
-- 
2.43.0
