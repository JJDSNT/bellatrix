+#elif defined(BELLATRIX)
+
+#include "cpu/emu68/bellatrix.h"
+#include "cpu/cpu_bridge.h"
+#include <boards.h>
+
+#if BELLATRIX_ENABLE_EMU68_BOARDS
+static int bellatrix_board_idx;
+static struct ExpansionBoard **bellatrix_board;
+
+extern struct ExpansionBoard *__boards_start;
+extern int zorro_disable;
+
+static void bellatrix_emu68_boards_init_once(void)
+{
+    if (!bellatrix_board)
+        bellatrix_board = &__boards_start;
+}
+
+void bellatrix_emu68_boards_reset(void)
+{
+    bellatrix_board = &__boards_start;
+    bellatrix_board_idx = 0;
+}
+
+static struct ExpansionBoard *bellatrix_emu68_current_board(void)
+{
+    bellatrix_emu68_boards_init_once();
+
+    while (bellatrix_board[bellatrix_board_idx] &&
+           !bellatrix_board[bellatrix_board_idx]->enabled) {
+        bellatrix_board_idx++;
+    }
+
+    return bellatrix_board[bellatrix_board_idx];
+}
+
+static int bellatrix_emu68_handle_board_write(uint32_t far, uint32_t value)
+{
+    struct ExpansionBoard *board;
+
+    if (zorro_disable || far < 0x00e80000u || far > 0x00e8ffffu)
+        return 0;
+
+    board = bellatrix_emu68_current_board();
+    if (!board)
+        return 0;
+
+    if (board->is_z3) {
+        if (far == 0x00e80044u) {
+            board->map_base = (value & 0xffffu) << 16;
+            board->map(board);
+            bellatrix_board_idx++;
+            return 1;
+        }
+    } else {
+        if (far == 0x00e80048u) {
+            board->map_base = (value & 0xffu) << 16;
+            board->map(board);
+            bellatrix_board_idx++;
+            return 1;
+        }
+    }
+
+    if (far == 0x00e8004cu || far == 0x00e8004eu) {
+        bellatrix_board_idx++;
+        return 1;
+    }
+
+    return 0;
+}
+
+static int bellatrix_emu68_handle_board_read(uint64_t *value, int size, uint32_t far)
+{
+    struct ExpansionBoard *board;
+    const uint8_t *rom;
+
+    if (zorro_disable || size != 1 || far < 0x00e80000u || far > 0x00e8ffffu)
+        return 0;
+
+    board = bellatrix_emu68_current_board();
+    if (!board)
+        return 0;
+
+    rom = board->rom_file;
+    *value = rom[far - 0x00e80000u];
+    return 1;
+}
+#else
+void bellatrix_emu68_boards_reset(void)
+{
+}
+
+static int bellatrix_emu68_handle_board_write(uint32_t far, uint32_t value)
+{
+    (void)far;
+    (void)value;
+    return 0;
+}
+
+static int bellatrix_emu68_handle_board_read(uint64_t *value, int size, uint32_t far)
+{
+    (void)value;
+    (void)size;
+    (void)far;
+    return 0;
+}
+#endif
+
+int SYSWriteValToAddr(uint64_t value, uint64_t value2, int size, uint64_t far)
+{
+    D(kprintf("[JIT:SYS] SYSWriteValToAddr(0x%x, %d, %p)\n", value, size, far));
+    (void)value2;
+
+    if ((far >> 32) == 1 || (far >> 32) == 0xffffffff)
+        far &= 0xffffffff;
+
+    /* kprintf inside the Bellatrix bridge path clobbers x18 (M68K PC) and v30
+     * (JIT instruction counter; caller-saved SIMD reg). Save/restore both. */
+    uint64_t _x18_save, _v30_save;
+    asm volatile("mov %0, x18" : "=r"(_x18_save));
+    asm volatile("mov %0, v30.d[0]" : "=r"(_v30_save));
+    bellatrix_emu68_report_jit_progress(_v30_save, (uint32_t)_x18_save);
+
+    if (bellatrix_emu68_handle_board_write((uint32_t)far, (uint32_t)value)) {
+        asm volatile("mov v30.d[0], %0" :: "r"(_v30_save));
+        asm volatile("mov x18, %0" :: "r"(_x18_save));
+        return 1;
+    }
+
+    /* Expose actual M68K PC (x18) so the Bellatrix bridge can log it accurately. */
+    g_bellatrix_fault_pc = (uint32_t)_x18_save;
+    bellatrix_bus_access((uint32_t)far, (uint32_t)value, size, BUS_WRITE);
+    asm volatile("mov v30.d[0], %0" :: "r"(_v30_save));
+    asm volatile("mov x18, %0" :: "r"(_x18_save));
+    return 1;
+}
+
+int SYSReadValFromAddr(uint64_t *value, uint64_t *value2, int size, uint64_t far)
+{
+    D(kprintf("[JIT:SYS] SYSReadValFromAddr(%d, %p)\n", size, far));
+
+    if ((far >> 32) == 1 || (far >> 32) == 0xffffffff)
+        far &= 0xffffffff;
+
+    /* kprintf inside the Bellatrix bridge path clobbers x18 (M68K PC) and v30
+     * (JIT instruction counter; caller-saved SIMD reg). Save/restore both. */
+    uint64_t _x18_save, _v30_save;
+    asm volatile("mov %0, x18" : "=r"(_x18_save));
+    asm volatile("mov %0, v30.d[0]" : "=r"(_v30_save));
+    bellatrix_emu68_report_jit_progress(_v30_save, (uint32_t)_x18_save);
+
+    if (bellatrix_emu68_handle_board_read(value, size, (uint32_t)far)) {
+        asm volatile("mov v30.d[0], %0" :: "r"(_v30_save));
+        asm volatile("mov x18, %0" :: "r"(_x18_save));
+        if (value2) *value2 = 0;
+        return 1;
+    }
+
+    /* Expose actual M68K PC (x18) so the Bellatrix bridge can log it accurately. */
+    g_bellatrix_fault_pc = (uint32_t)_x18_save;
+    *value = bellatrix_bus_access((uint32_t)far, 0, size, BUS_READ);
+    asm volatile("mov v30.d[0], %0" :: "r"(_v30_save));
+    asm volatile("mov x18, %0" :: "r"(_x18_save));
+    if (value2) *value2 = 0;
+    return 1;
+}
+
 #else
 
 int SYSWriteValToAddr(uint64_t value, uint64_t value2, int size, uint64_t far)
