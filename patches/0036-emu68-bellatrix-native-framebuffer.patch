+#ifdef BELLATRIX
+    /* Export Bellatrix's software-Denise scanout to guest-side display
+       drivers.  VideoCore.card consumes this as the native HVS plane and
+       switches between it and the P96 RTG plane in SetSwitch(). */
+    {
+        of_node_t *emu68 = dt_find_node("/emu68");
+        uint32_t native_fb[] = {
+            (uint32_t)(uintptr_t)framebuffer,
+            fb_width,
+            fb_height,
+            pitch
+        };
+        if (emu68)
+            dt_add_property(emu68, "bellatrix-native-fb",
+                            native_fb, sizeof(native_fb));
+    }
+#endif
+
     start_x = (sz.width - EmuLogo.el_Width) / 2;
     start_y = (sz.height - EmuLogo.el_Height) / 2;
 
