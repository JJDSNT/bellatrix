index e8dd8d9..9ed96f7 100644
--- a/m68k_in.c
+++ b/m68k_in.c
@@ -917,18 +917,33 @@ M68KMAKE_OP(1111, 0, ., .)
 
 M68KMAKE_OP(040fpu0, 32, ., .)
 {
-	if(CPU_TYPE_IS_030_PLUS(CPU_TYPE))
+	/* Bellatrix: dispatch for CPU_TYPE 68030 or 68040 (either macro
+	 * true — CPU_TYPE_IS_040_PLUS only needs M68K_EMULATE_040 on,
+	 * which matters for configs like the bare-metal build that enable
+	 * 040 without 030). 68000/010/020 fall through by design in this
+	 * Musashi variant, not a bug — see ISSUE-0034. */
+	if(CPU_TYPE_IS_040_PLUS(CPU_TYPE) || CPU_TYPE_IS_030_PLUS(CPU_TYPE))
 	{
 		m68040_fpu_op0();
 		return;
 	}
+	/* Logged so a real "FPU-capable CPU still traps" bug is
+	 * distinguishable from the expected 000/010/020 case. */
+	{
+		static int s_hits = 0;
+		if (s_hits < 10) {
+			s_hits++;
+			kprintf("[040FPU0-GATE-FAIL] CPU_TYPE=%u pc=%08x ir=%04x\n",
+			       (unsigned)CPU_TYPE, (unsigned)ADDRESS_68K(REG_PPC), (unsigned)REG_IR);
+		}
+	}
 	m68ki_exception_1111();
 }
 
 
