From f25dc62866fc97149710350496882a51871e0002 Mon Sep 17 00:00:00 2001
From: Bellatrix contributors <bellatrix@localhost>
Date: Tue, 25 Aug 2026 10:30:00 -0300
Subject: [PATCH] glinfo: bracket each string query

Keep the GL string query separate from printf so the serial markers identify
whether a delay is in Mesa or in console output.
---
 Demo/GL/MesaGL/glinfo.c | 30 +++++++++++++++++++++++++-----
 1 file changed, 25 insertions(+), 5 deletions(-)

diff --git a/Demo/GL/MesaGL/glinfo.c b/Demo/GL/MesaGL/glinfo.c
index e34db365..bcafefb7 100644
--- a/Demo/GL/MesaGL/glinfo.c
+++ b/Demo/GL/MesaGL/glinfo.c
@@ -75,6 +75,12 @@ ADD2INIT(glinfo_ctor_last, -110);
 
 int main( int argc, char *argv[] )
 {
+   const GLubyte *version;
+   const GLubyte *extensions;
+   const GLubyte *renderer;
+   const GLubyte *vendor;
+   const GLubyte *shading_language_version;
+
    STEP("main entered");
    glutInit( &argc, argv );
    STEP("glutInit returned");
@@ -85,12 +91,26 @@ int main( int argc, char *argv[] )
    STEP("glutCreateWindow returned");
 
    STEP("asking GL_VERSION");
-   printf("GL_VERSION: %s\n", (char *) glGetString(GL_VERSION));
+   version = glGetString(GL_VERSION);
    STEP("GL_VERSION answered");
-   printf("GL_EXTENSIONS: %s\n", (char *) glGetString(GL_EXTENSIONS));
-   printf("GL_RENDERER: %s\n", (char *) glGetString(GL_RENDERER));
-   printf("GL_VENDOR: %s\n", (char *) glGetString(GL_VENDOR));
-   printf("GL_SHADING_LANGUAGE_VERSION: %s\n\n", (char *) glGetString(GL_SHADING_LANGUAGE_VERSION));
+   STEP("asking GL_EXTENSIONS");
+   extensions = glGetString(GL_EXTENSIONS);
+   STEP("GL_EXTENSIONS answered");
+   STEP("asking GL_RENDERER");
+   renderer = glGetString(GL_RENDERER);
+   STEP("GL_RENDERER answered");
+   STEP("asking GL_VENDOR");
+   vendor = glGetString(GL_VENDOR);
+   STEP("GL_VENDOR answered");
+   STEP("asking GL_SHADING_LANGUAGE_VERSION");
+   shading_language_version = glGetString(GL_SHADING_LANGUAGE_VERSION);
+   STEP("GL_SHADING_LANGUAGE_VERSION answered");
+
+   printf("GL_VERSION: %s\n", (char *) version);
+   printf("GL_EXTENSIONS: %s\n", (char *) extensions);
+   printf("GL_RENDERER: %s\n", (char *) renderer);
+   printf("GL_VENDOR: %s\n", (char *) vendor);
+   printf("GL_SHADING_LANGUAGE_VERSION: %s\n\n", (char *) shading_language_version);
    printf("GLU_VERSION: %s\n", (char *) gluGetString(GLU_VERSION));
    printf("GLU_EXTENSIONS: %s\n\n", (char *) gluGetString(GLU_EXTENSIONS));
    printf("GLUT_API_VERSION: %d\n", GLUT_API_VERSION);
-- 
