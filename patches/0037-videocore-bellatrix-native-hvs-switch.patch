+void VC6_ConstructNativeDL(struct VC4Base *VC4Base)
+{
+    volatile uint32_t *displist = (uint32_t *)0xf2404000;
+    ULONG allocation = BuddyAlloc(VC4Base, 16);
+    ULONG cnt = BUDDY_OFFSET(allocation);
+
+    VC4Base->vc4_NativeDL = allocation;
+    wr32le(&displist[cnt++], VC6_CONTROL_VALID | VC6_CONTROL_WORDS(8) |
+           VC6_CONTROL_UNITY | VC6_CONTROL_ALPHA_EXPAND |
+           VC6_CONTROL_RGB_EXPAND | mode_table[RGBFB_R5G6B5PC]);
+    wr32le(&displist[cnt++], VC6_POS0_X(0) | VC6_POS0_Y(0));
+    wr32le(&displist[cnt++],
+           (VC6_SCALER_POS2_ALPHA_MODE_FIXED <<
+            VC6_SCALER_POS2_ALPHA_MODE_SHIFT) |
+           VC6_SCALER_POS2_ALPHA(0xfff));
+    wr32le(&displist[cnt++], VC6_POS2_H(VC4Base->vc4_NativeHeight) |
+           VC6_POS2_W(VC4Base->vc4_NativeWidth));
+    wr32le(&displist[cnt++], 0xdeadbeef);
+    wr32le(&displist[cnt++], 0xc0000000 |
+           (ULONG)VC4Base->vc4_NativeBuffer);
+    wr32le(&displist[cnt++], 0xdeadbeef);
+    wr32le(&displist[cnt++], VC4Base->vc4_NativePitch);
+    wr32le(&displist[cnt++], 0x80000000);
+}
+
 void VC6_SetPanning(REGARG(struct BoardInfo *b, "a0"), REGARG(UBYTE *addr, "a1"), 
                     REGARG(UWORD width, "d0"), REGARG(WORD x_offset, "d1"), 
