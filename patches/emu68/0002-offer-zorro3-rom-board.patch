From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jaime Dias <jaimejosediasnt@gmail.com>
Date: Sat, 1 Aug 2026 16:02:37 -0300
Subject: [PATCH 2/3] Offer the Zorro III ROM board to non-PiStorm guests

Emu68 already builds a Z3 ROM board carrying its own m68k modules --
brcm-sdhc.device, brcm-emmc.device, mailbox.resource, gic400.library,
devicetree.resource, unicam.resource and the rest (src/boards/emu68rom.c).
Until now only a PiStorm guest could ever see them: the board list was walked
only by the PiStorm protocol code, and src/boards was compiled only for that
variant, so a standalone build linked an empty list.

That is the same shape as the interrupt registers before the previous commit
-- the machinery is all present, and one variant holds the only key to it.

The autoconfig protocol itself is identical whether the cycles arrive off a
real Amiga bus or are trapped here: the guest reads a board's ROM to see what
it is, writes a base address to configure it, or writes shutup to decline it.
So the same handling moves out of the PiStorm branch, the board list and walk
index become shared, and a faulting page is carved out at 0xE80000 the way one
already is at 0xDFF000.

z2ram.c is deliberately left out of the standalone build: it exists to offer
Zorro II RAM to a real Amiga, and a standalone guest already has all of memory.

Verified not to regress: an AROS guest that does no autoconfig boots exactly as
before. Exercising the board needs a guest that calls ConfigChain(), which is
the other half of this work.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 CMakeLists.txt        | 13 ++++++++
 src/aarch64/start.c   | 24 +++++++++++++
 src/aarch64/vectors.c | 78 +++++++++++++++++++++++++++++++++++++++++--
 3 files changed, 112 insertions(+), 3 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 63d0d03..7118598 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -269,6 +269,19 @@ if (${VARIANT} IN_LIST SUPPORTED_VARIANTS)
         else()
             message(FATAL_ERROR "PiStorm variants are supported on raspi targets, only.")
         endif()
+    else()
+        # Standalone. There is no Amiga bus to autoconfig over, but the guest
+        # can still be offered Emu68's own Zorro III ROM board and the m68k
+        # modules it carries - brcm-sdhc.device, brcm-emmc.device,
+        # mailbox.resource, gic400.library, devicetree.resource and the rest.
+        # The autoconfig cycles are trapped and emulated in
+        # src/aarch64/vectors.c, the same way the interrupt registers are.
+        #
+        # z2ram.c is deliberately left out: it exists to offer Zorro II RAM to
+        # a real Amiga, and a standalone guest already has all of memory.
+        list(APPEND BASE_FILES
+            src/boards/emu68rom.c
+        )
     endif()
 else()
     message(FATAL_ERROR "Wrong variant selected: ${VARIANT}")
diff --git a/src/aarch64/start.c b/src/aarch64/start.c
index c54a35b..4c9949a 100644
--- a/src/aarch64/start.c
+++ b/src/aarch64/start.c
@@ -19,6 +19,7 @@
 #include "M68k.h"
 #include "HunkLoader.h"
 #include "ElfLoader.h"
+#include "boards.h"
 #include "DuffCopy.h"
 #include "EmuLogo.h"
 #include "EmuFeatures.h"
@@ -1382,6 +1383,29 @@ void boot(void *dtree)
             like memory - see SYSWriteValToAddr()/SYSReadValFromAddr().
         */
         mmu_map(0x00dff000, 0x00dff000, 4096, 0, 0);
+
+        /*
+            And the same for Zorro autoconfig space, so the guest can find the
+            ROM board carrying Emu68's own m68k modules. Without a PiStorm
+            there is no expansion bus to answer these cycles, so the page is
+            carved out and answered from the board list instead - see the
+            AUTOCONFIG_BASE handling in vectors.c.
+        */
+        mmu_map(0x00e80000, 0x00e80000, 4096, 0, 0);
+
+        /*
+            Offer the boards from the start of the link-time board list. On
+            PiStorm this is done by the protocol code after bus reset; there is
+            no reset here, so it is set up once during boot.
+        */
+        {
+            extern struct ExpansionBoard *__boards_start;
+            extern struct ExpansionBoard **board;
+            extern int board_idx;
+
+            board = &__boards_start;
+            board_idx = 0;
+        }
 #endif
 
         if (vid_base) {
diff --git a/src/aarch64/vectors.c b/src/aarch64/vectors.c
index 1e93974..a96978c 100644
--- a/src/aarch64/vectors.c
+++ b/src/aarch64/vectors.c
@@ -327,15 +327,24 @@ enum
     INTREQR = 0xDFF01E,
 };
 
-#ifdef PISTORM_ANY_MODEL
-
-#include "ps_protocol.h"
+/*
+    Zorro autoconfig space. Shared for the same reason: the ROM board holding
+    Emu68's own m68k modules is offered to guests without a PiStorm too (see
+    the #else branch below), so the board list and the walk index live here
+    rather than inside the variant.
+*/
+#define AUTOCONFIG_BASE 0xE80000
+#define AUTOCONFIG_END  0xE8FFFF
 
 #include <boards.h>
 
 int board_idx;
 struct ExpansionBoard **board;
 
+#ifdef PISTORM_ANY_MODEL
+
+#include "ps_protocol.h"
+
 uint32_t rom_mapped = 0;
 uint32_t overlay = 1;
 uint32_t z2_ram_autoconf = 1;
@@ -775,6 +784,46 @@ int SYSWriteValToAddr(uint64_t value, uint64_t value2, int size, uint64_t far)
         return 1;
     }
 
+    /*
+        Zorro autoconfig, guest -> board.
+
+        Emu68 already builds a Z3 ROM board carrying its own m68k modules -
+        brcm-sdhc.device, brcm-emmc.device, mailbox.resource, gic400.library,
+        devicetree.resource and friends (src/boards/emu68rom.c). Until now only
+        a PiStorm guest could ever see them, because nothing outside the
+        PiStorm protocol code walked the board list.
+
+        The guest configures a board by writing its base address, at which
+        point we map it and step to the next one; writing "shutup" skips a
+        board it does not want. That is the whole protocol, and it is identical
+        whether the autoconfig cycles come off a real Amiga bus or are trapped
+        here.
+    */
+    if (far >= AUTOCONFIG_BASE && far <= AUTOCONFIG_END && board && board[board_idx])
+    {
+        if (board[board_idx]->is_z3) {
+            if (far == 0xe80044) {
+                board[board_idx]->map_base = (value & 0xffff) << 16;
+                board[board_idx]->map(board[board_idx]);
+                board_idx++;
+            }
+        }
+        else {
+            if (far == 0xe80048) {
+                board[board_idx]->map_base = (value & 0xff) << 16;
+                board[board_idx]->map(board[board_idx]);
+                board_idx++;
+            }
+        }
+
+        /* Shut up: the guest declines this board and wants the next one. */
+        if (far == 0xe8004c || far == 0xe8004e) {
+            board_idx++;
+        }
+
+        return 1;
+    }
+
     switch(size)
     {
         case 1:
@@ -840,6 +889,29 @@ int SYSReadValFromAddr(uint64_t *value, uint64_t *value2, int size, uint64_t far
         return 1;
     }
 
+    /*
+        Zorro autoconfig, board -> guest.
+
+        The guest reads the current board's autoconfig ROM to learn what it is
+        and how much space it wants. Boards that are disabled are stepped over
+        so the guest only ever sees the ones actually on offer. Byte-sized
+        access only, which is what the autoconfig protocol uses.
+    */
+    if (far >= AUTOCONFIG_BASE && far <= AUTOCONFIG_END && size == 1 && board)
+    {
+        while (board[board_idx] && !board[board_idx]->enabled) {
+            board_idx++;
+        }
+
+        if (board[board_idx])
+        {
+            const uint8_t *rom = board[board_idx]->rom_file;
+            *value = rom[far - AUTOCONFIG_BASE];
+
+            return 1;
+        }
+    }
+
     switch(size)
     {
         case 1:
