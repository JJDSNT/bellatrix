From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jaime Dias <jaimejosediasnt@gmail.com>
Date: Sat, 1 Aug 2026 08:09:01 -0300
Subject: [PATCH 1/3] Emulate the Amiga interrupt registers on non-PiStorm
 builds

A guest running on a standalone Emu68 has no way to receive a host
interrupt. The core-0 IRQ fast path raises m68k level 6 only when
INT_shadow.INTENA has INTEN|EXTER set, and every writer of that field
lives inside #ifdef PISTORM_ANY_MODEL, so on VARIANT=none the gate is
zero from reset and nothing in the firmware can open it. The interrupt
arrives -- ARMPending is stored two instructions before the gate -- and
is then dropped.

Rather than add an interface, serve the registers the guest already
knows. INTENA/INTREQ writes and INTENAR/INTREQR reads are emulated for
non-PiStorm builds too, backed by the same INT_shadow. The read side
differs from the PiStorm one: with no Paula on a bus there is nothing to
snoop, so the values are served from the shadow, and INTREQR reports
EXTER whenever ARMPending is set. That is what lets an unmodified Amiga
level-6 handler conclude EXTER fired and run its server chain.

The custom register page is ordinary RAM on these builds, so it is
carved out of the guest mapping the same way the 0xdeadbeef debug page
already is. Everything else in the page still behaves as memory.

Verified on qemu raspi3b with AROS/m68k driving a BCM283x system timer:
INTENAR reads back 0x6000, level 6 is entered per timer compare, and the
INTREQ acknowledge lets subsequent interrupts through. No guest-side
Emu68-specific code is involved.

PiStorm builds are untouched.
---
 src/aarch64/start.c   |  12 +++++
 src/aarch64/vectors.c | 109 ++++++++++++++++++++++++++++++++++++------
 2 files changed, 107 insertions(+), 14 deletions(-)

diff --git a/src/aarch64/start.c b/src/aarch64/start.c
index 0f8200e..c54a35b 100644
--- a/src/aarch64/start.c
+++ b/src/aarch64/start.c
@@ -1372,6 +1372,18 @@ void boot(void *dtree)
         /* Make a hole for 0xdeadbeef */
         mmu_map(0xdeadbeef & ~4095, 0xdeadbeef & ~4095, 4096, 0, 0);
 
+#ifndef PISTORM_ANY_MODEL
+        /*
+            Make a hole for the custom chip register page so that a guest with
+            no Paula can still reach INTENA/INTREQ. On PiStorm the whole Amiga
+            address space already faults through to the bus; here it is plain
+            RAM, so the one page carrying the interrupt registers has to be
+            carved out explicitly. Everything else in the page keeps behaving
+            like memory - see SYSWriteValToAddr()/SYSReadValFromAddr().
+        */
+        mmu_map(0x00dff000, 0x00dff000, 4096, 0, 0);
+#endif
+
         if (vid_base) {
             uint32_t reg[] = {
                 vid_base, vid_memory * 1024*1024
diff --git a/src/aarch64/vectors.c b/src/aarch64/vectors.c
index 9c9c85b..1e93974 100644
--- a/src/aarch64/vectors.c
+++ b/src/aarch64/vectors.c
@@ -311,6 +311,22 @@ static int getOPsize(uint32_t opcode)
 #undef D
 #define D(x) /* x */
 
+/*
+    Amiga specific registers. Shared by both variants: the interrupt registers
+    are emulated for guests without Paula too (see the #else branch below).
+*/
+enum
+{
+    CIAAPRA = 0xBFE001,
+    CIABPRB = 0xBFD100,
+
+    VPOSR   = 0xDFF004,
+    INTENA  = 0xDFF09A,
+    INTENAR = 0xDFF01C,
+    INTREQ  = 0xDFF09C,
+    INTREQR = 0xDFF01E,
+};
+
 #ifdef PISTORM_ANY_MODEL
 
 #include "ps_protocol.h"
@@ -330,19 +346,6 @@ uint32_t spoof_df0_id = 0;
 
 uint32_t move_slow_to_chip = 0;
 
-// Amiga specific registers
-enum
-{
-    CIAAPRA = 0xBFE001,
-    CIABPRB = 0xBFD100,
-
-    VPOSR   = 0xDFF004,
-    INTENA  = 0xDFF09A,
-    INTENAR = 0xDFF01C,
-    INTREQ  = 0xDFF09C,
-    INTREQR = 0xDFF01E,
-};
-
 int block_c0;
 extern int zorro_disable;
 extern int disable_scsi;
@@ -732,6 +735,46 @@ int SYSWriteValToAddr(uint64_t value, uint64_t value2, int size, uint64_t far)
         return 1;
     }
 
+    /*
+        Interrupt registers. There is no Paula on this machine, so these are
+        not snooped off a bus on their way to a chipset - they *are* the
+        interrupt controller the guest programs, backed by the same INT_shadow
+        that the core-0 IRQ fast path in __stub_vectors() gates on.
+
+        This is what lets a guest with no chipset arm and acknowledge host
+        interrupts the ordinary Amiga way, with no Emu68-specific code.
+    */
+    if (far == INTENA) {
+        if (value & 0x8000) {
+            INT_shadow.INTENA |= value & 0x7fff;
+        }
+        else {
+            INT_shadow.INTENA &= ~(value & 0x7fff);
+        }
+        if (INT_shadow.ARMPending) {
+            struct M68KState *ctx;
+            __asm__ volatile("mov %0, "CTX_POINTER_ASM"\n":"=r"(ctx));
+            ctx->INTF.ARM = (INT_shadow.INTENA & 0x6000) == 0x6000 ? 0x01 : 0;
+        }
+        return 1;
+    }
+
+    if (far == INTREQ) {
+        if (value & 0x8000) {
+            INT_shadow.INTREQ |= value & 0x3fff;
+        }
+        else {
+            INT_shadow.INTREQ &= ~(value & 0x3fff);
+        }
+        if ((value & 0xa000) == 0x2000) {
+            struct M68KState *ctx;
+            __asm__ volatile("mov %0, "CTX_POINTER_ASM"\n":"=r"(ctx));
+            ctx->INTF.ARM = 0;
+            INT_shadow.ARMPending = 0;
+        }
+        return 1;
+    }
+
     switch(size)
     {
         case 1:
@@ -758,7 +801,45 @@ int SYSWriteValToAddr(uint64_t value, uint64_t value2, int size, uint64_t far)
 int SYSReadValFromAddr(uint64_t *value, uint64_t *value2, int size, uint64_t far)
 {
     D(kprintf("[JIT:SYS] SYSReadValFromAddr(%d, %p)\n", size, far));
-    
+
+    /*
+        On PiStorm these two snoop the values coming back from a real Paula.
+        With no Paula present they have to be served from the shadow instead.
+
+        INTREQR reporting EXTER whenever the ARM side has an interrupt pending
+        is the part that matters: it lets an unmodified Amiga level-6 handler
+        conclude that EXTER fired and run its interrupt server chain.
+
+        Byte and word access only, which is all a 16-bit chip register can be
+        read with. Wider accesses fall through to memory as before - claiming
+        one would leave *value2 unset on a 16-byte read and hand the guest a
+        register full of stack garbage.
+    */
+    if ((far & ~1) == INTENAR && size <= 2) {
+        uint16_t ena = INT_shadow.INTENA;
+
+        if (size == 2)
+            *value = ena;
+        else
+            *value = (far & 1) ? (ena & 0xff) : (ena >> 8);
+
+        return 1;
+    }
+
+    if ((far & ~1) == INTREQR && size <= 2) {
+        uint16_t req = INT_shadow.INTREQ;
+
+        if (INT_shadow.ARMPending)
+            req |= 0x2000;
+
+        if (size == 2)
+            *value = req;
+        else
+            *value = (far & 1) ? (req & 0xff) : (req >> 8);
+
+        return 1;
+    }
+
