From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jaime Dias <jaimejosediasnt@gmail.com>
Date: Sat, 30 Aug 2026 00:00:00 -0300
Subject: [PATCH] Buffer a line per core before the UART

kprintf reaches the UART one character at a time, so two cores logging at
once interleave mid-word and the output stops being readable. With the
chipset on a core of its own that happens on every periodic report.

Each core now assembles its own line in memory nobody else touches, and
the UART is entered once per line. The lock is only taken when a second
core is actually running, so this costs nothing before that and needs no
exclusive monitor at a stage of boot where the MMU may not be up.

Garbled output is not cosmetic: it is the loss of the instrument you are
debugging with.
---
 src/raspi/support_rpi.c | 90 +++++++++++++++++++++++++++++++++++++++++++++----
diff --git a/src/raspi/support_rpi.c b/src/raspi/support_rpi.c
--- a/src/raspi/support_rpi.c
+++ b/src/raspi/support_rpi.c
@@ -114,28 +114,158 @@
 
 static inline void waitSerOUT(void *io_base)
 {
-    while(1)
+    /*
+     * Bounded. An unbounded wait on a peripheral means a wedged UART stops the
+     * machine, and a console that can stop the machine is worse than no
+     * console. The legacy tree bounds the same loop for the same reason.
+     */
+    unsigned spins = 1000000;
+
+    while (spins-- != 0)
     {
        if (CONSOLE_UART_CAN_WRITE(rd32le(CONSOLE_UART_FR))) break;
     }
 }
 
-static inline void putByte(void *io_base, char chr)
+static inline void putRawByte(void *io_base, char chr)
 {
-    if (serial_up)
+    waitSerOUT(io_base);
+
+    if (chr == '\n')
     {
+        wr32le(CONSOLE_UART_DR, '\r');
         waitSerOUT(io_base);
+    }
+    wr32le(CONSOLE_UART_DR, (uint8_t)chr);
+    waitSerOUT(io_base);
+}
+
+#if defined(BELLATRIX_EMU68) && CONFIG_RIGEL
+/*
+ * A line buffer per core.
+ *
+ * kprintf reaches the UART one character at a time, so two cores logging at
+ * once interleave mid-word and the output stops being readable -- exactly this,
+ * from a boot with the chipset on a core of its own:
+ *
+ *     [ELF Loader] exec section 1 at 0x042[BELLATRIX:RIGEL:PERF] 4000421 CCK
+ *
+ * The legacy tree met the same thing and its note is worth the whole fix:
+ * buffering each core's line "destravou diagnóstico" -- garbled output is not
+ * a cosmetic problem, it is the loss of the instrument you are debugging with.
+ *
+ * So each core assembles its own line, alone, in memory nobody else touches,
+ * and the UART is entered once per line rather than once per character. The
+ * lock is only taken when a second core is actually running: before that this
+ * costs nothing and, more to the point, needs no exclusive monitor at a stage
+ * of boot where the MMU may not be up.
+ */
+#define CONSOLE_LINE_MAX 200
+
+static char console_line[4][CONSOLE_LINE_MAX];
+static unsigned console_line_len[4];
+volatile int console_multicore = 0;
+static volatile int console_lock = 0;
+
+static inline unsigned console_this_core(void)
+{
+    uint64_t mpidr;
+    __asm__ volatile("mrs %0, MPIDR_EL1" : "=r"(mpidr));
+    return (unsigned)(mpidr & 3);
+}
 
-        if (chr == '\n')
+static inline void console_emit(void *io_base, unsigned core)
+{
+    /*
+     * Bounded, and read once.
+     *
+     * Two defects here on the first attempt, and the second is the one worth
+     * remembering. The flag was read twice -- once to acquire and once to
+     * release -- and the second core sets it between those two reads, so a
+     * core that skipped the acquire went on to clear a lock it never held.
+     *
+     * The real mistake was putting an unbounded wait in the diagnostic path at
+     * all. A log is the instrument you debug the machine with, and it must
+     * never be able to stop the machine: the boot went from reaching services
+     * to stopping at the line before the second core's first word, and the
+     * only new thing was this lock.
+     *
+     * So spin a bounded number of times and then write anyway. The worst case
+     * is a garbled line, which is what we had before and can live with; a
+     * machine that stops is not.
+     */
+    enum { CONSOLE_LOCK_SPINS = 100000 };
+    int locked = 0;
+    unsigned i;
+
+    if (console_multicore)
+    {
+        unsigned spins = CONSOLE_LOCK_SPINS;
+
+        while (spins-- != 0)
         {
-            wr32le(CONSOLE_UART_DR, '\r');
-            waitSerOUT(io_base);
+            if (!__atomic_test_and_set(&console_lock, __ATOMIC_ACQUIRE))
+            {
+                locked = 1;
+                break;
+            }
+            __asm__ volatile("yield" ::: "memory");
         }
-        wr32le(CONSOLE_UART_DR, (uint8_t)chr);
-        waitSerOUT(io_base);
     }
+
+    for (i = 0; i < console_line_len[core]; i++)
+        putRawByte(io_base, console_line[core][i]);
+
+    if (locked)
+        __atomic_clear(&console_lock, __ATOMIC_RELEASE);
+
+    console_line_len[core] = 0;
 }
 
+static inline void putByte(void *io_base, char chr)
+{
+    unsigned core;
+
+    if (!serial_up)
+        return;
+
+    core = console_this_core();
+
+    /*
+     * The boot core is never buffered.
+     *
+     * Buffering hides a hang: a line only appears when it ends, so a core that
+     * stops mid-print leaves its last partial line invisible. That cost was
+     * written into this file's first version and then paid immediately -- a
+     * hardware boot appeared to stop one line earlier than it did, and the
+     * evidence of where it really stopped was sitting in a buffer.
+     *
+     * The legacy tree's answer was a direct mode for early boot, on the
+     * grounds that only one core runs then. Ours is stronger and simpler: the
+     * boot core is *always* direct, so where it stopped is always on the wire.
+     * Only the secondary cores buffer, and they are the rare printers, so the
+     * interleaving this exists to prevent is prevented anyway.
+     */
+    if (core == 0)
+    {
+        putRawByte(io_base, chr);
+        return;
+    }
+
+    if (console_line_len[core] < CONSOLE_LINE_MAX)
+        console_line[core][console_line_len[core]++] = chr;
+
+    if (chr == '\n' || console_line_len[core] == CONSOLE_LINE_MAX)
+        console_emit(io_base, core);
+}
+#else
+static inline void putByte(void *io_base, char chr)
+{
+    if (serial_up)
+        putRawByte(io_base, chr);
+}
+#endif
+
 #endif
 
 #undef ARM_PERIIOBASE
