     unsigned int        uartvar;
     unsigned const int uartbaud = 115200;
     unsigned int uartclock;
@@ -485,6 +533,7 @@ void setup_serial()
     for (uartvar = 0; uartvar < 150; uartvar++) asm volatile ("nop");
 
     serial_up = 1;
+#endif
 }
 
 #endif
