+#else
     usb_osal_mq_send(bus->hub_mq, (uintptr_t)NULL);
     usb_osal_sem_take(bus->hub_sem, USB_OSAL_WAITING_FOREVER);
     usb_osal_sem_delete(bus->hub_sem);
