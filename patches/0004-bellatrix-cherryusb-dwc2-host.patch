+/* Bellatrix: the host runs AArch64 big-endian. The CBW/CSW uint32 fields
+ * (dSignature/dTag/dDataLength, dDataResidue) must be little-endian on the
+ * wire — writing them through the struct sends them byte-swapped and the
+ * device rejects the CBW (STALLs both bulk endpoints per BOT 6.6.1).
+ * Serialize/deserialize explicitly; this is a no-op on LE hosts. */
+static void usbh_msc_put_le32(uint8_t *p, uint32_t v)
+{
+    p[0] = (uint8_t)(v);
+    p[1] = (uint8_t)(v >> 8);
+    p[2] = (uint8_t)(v >> 16);
+    p[3] = (uint8_t)(v >> 24);
+}
+
+static uint32_t usbh_msc_get_le32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+           ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
