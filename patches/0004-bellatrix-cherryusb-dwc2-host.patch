-            nbytes = usbh_msc_bulk_in_transfer(msc_class, buffer, cbw->dDataLength, timeout);
+            nbytes = usbh_msc_bulk_in_transfer(msc_class, buffer, datalen, timeout);
         }
 
         if (nbytes < 0) {
@@ -166,6 +192,11 @@ static int usbh_bulk_cbw_csw_xfer(struct usbh_msc *msc_class, struct CBW *cbw, s
         goto __err_exit;
     }
 
