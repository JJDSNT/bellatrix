+    uint32_t datalen;
 
     usbh_msc_cbw_dump(cbw);
 
+    /* Capture host-order values, then serialize the u32 fields as LE */
+    datalen = cbw->dDataLength;
+    usbh_msc_put_le32((uint8_t *)&cbw->dSignature, MSC_CBW_Signature);
+    usbh_msc_put_le32((uint8_t *)&cbw->dTag, cbw->dTag);
+    usbh_msc_put_le32((uint8_t *)&cbw->dDataLength, datalen);
+
     /* Send the CBW */
     nbytes = usbh_msc_bulk_out_transfer(msc_class, (uint8_t *)cbw, USB_SIZEOF_MSC_CBW, timeout);
     if (nbytes < 0) {
@@ -138,18 +164,18 @@ static int usbh_bulk_cbw_csw_xfer(struct usbh_msc *msc_class, struct CBW *cbw, s
         goto __err_exit;
     }
 
-    if (cbw->dDataLength != 0) {
+    if (datalen != 0) {
         if (cbw->CB[0] == SCSI_CMD_WRITE10) {
-            nbytes = usbh_msc_bulk_out_transfer(msc_class, buffer, cbw->dDataLength, timeout);
+            nbytes = usbh_msc_bulk_out_transfer(msc_class, buffer, datalen, timeout);
         } else if (cbw->CB[0] == SCSI_CMD_READCAPACITY10) {
-            nbytes = usbh_msc_bulk_in_transfer(msc_class, buffer, cbw->dDataLength, timeout);
+            nbytes = usbh_msc_bulk_in_transfer(msc_class, buffer, datalen, timeout);
             if (nbytes >= 0) {
