+static void usbh_hub_cleanup(struct usbh_bus *bus)
+{
+    struct usbh_hub *hub;
+    struct usbh_hubport *hport;
+
+    hub = &bus->hcd.roothub;
+    for (uint8_t port = 0; port < hub->nports; port++) {
+        hport = &hub->child[port];
+        usbh_hubport_release(hport);
+    }
+
+    if (bus->hub_mq) {
+        usb_osal_mq_delete(bus->hub_mq);
+        bus->hub_mq = NULL;
+    }
+    if (bus->hub_sem) {
+        usb_osal_sem_delete(bus->hub_sem);
+        bus->hub_sem = NULL;
+    }
+    if (bus->hub_started) {
+        usb_hc_deinit(bus);
+        bus->hub_started = 0;
+    }
+}
+
 void usbh_hub_thread_wakeup(struct usbh_hub *hub)
 {
+    USB_LOG_INFO("Bellatrix USBH: wake hub=%u root=%u intbuf=0x%02x\r\n",
+                 (unsigned int)hub->index,
+                 (unsigned int)hub->is_roothub,
+                 (unsigned int)hub->int_buffer[0]);
     usb_osal_mq_send(hub->bus->hub_mq, (uintptr_t)hub);
 }
 
+void usbh_hub_poll(struct usbh_bus *bus)
+{
+    struct usbh_hub *hub;
+    int ret;
+
+    if (!bus || !bus->hub_mq) {
+        return;
+    }
+
+    if (!bus->hub_started) {
+        bus->hub_started = 1;
+        bus->event_handler(bus->busid, USB_HUB_INDEX_ANY, USB_HUB_PORT_ANY, USB_INTERFACE_ANY, USBH_EVENT_INIT);
+        usb_hc_init(bus);
+    }
+
+    while (1) {
+        ret = usb_osal_mq_recv(bus->hub_mq, (uintptr_t *)&hub, 0);
+        if (ret < 0) {
+            break;
+        }
+        if (hub == NULL) {
+            usbh_hub_cleanup(bus);
+            break;
+        }
+        USB_LOG_INFO("Bellatrix USBH: poll hub event hub=%u root=%u intbuf=0x%02x\r\n",
+                     (unsigned int)hub->index,
+                     (unsigned int)hub->is_roothub,
+                     (unsigned int)hub->int_buffer[0]);
+        usbh_hub_events(hub);
+    }
+}
+
