From ca089287723be5f451fc3e29238f75186bae9f3e Mon Sep 17 00:00:00 2001
From: Jaime Dias <jaimejosediasnt@gmail.com>
Date: Mon, 26 Oct 2026 10:12:06 -0300
Subject: [PATCH 2/2] util/ralloc: don't assume malloc() aligns beyond
 max_align_t

The header is declared alignas(8) on 32-bit targets and alignas(16) on
64-bit ones, on the grounds that this is what malloc() returns. C11 only
promises alignof(max_align_t), and that is smaller on some targets: on
m68k it is 2, and AROS's malloc() returns blocks that are 4 modulo 8.
The header then lands misaligned, and the linear allocator's
SUBALLOC_ALIGNMENT assertion fires on the first context it creates.

Where alignof(max_align_t) is less than the header's alignment, take
blocks from os_malloc_aligned() and resize by allocating, copying and
freeing. os_realloc_aligned() is not used because it frees the old block
even when the new allocation fails, which realloc() must not do.

The copy needs the payload size, so the header's size field, which was
debug-only, is now always present. It fills padding the header already
had, so the header stays the same size on 32- and 64-bit targets, in
release and debug builds alike. resize() now also keeps it up to date,
which fixes ralloc_total_size() reporting the size from before a
reralloc in debug builds.

The test is a compile-time constant: everywhere alignof(max_align_t) is
large enough, the aligned path compiles away and behaviour is unchanged.
---
 src/util/meson.build           |   1 +
 src/util/ralloc.c              |  65 ++++++++++++-
 src/util/tests/ralloc_test.cpp | 167 +++++++++++++++++++++++++++++++++
 3 files changed, 228 insertions(+), 5 deletions(-)
 create mode 100644 src/util/tests/ralloc_test.cpp

diff --git a/src/util/meson.build b/src/util/meson.build
index b11f0c4..20d3fb2 100644
--- a/src/util/meson.build
+++ b/src/util/meson.build
@@ -481,6 +481,7 @@ if with_tests
     'tests/mesa-blake3_test.cpp',
     'tests/os_mman_test.cpp',
     'tests/perf/u_trace_test.cpp',
+    'tests/ralloc_test.cpp',
     'tests/range_minimum_query_test.cpp',
     'tests/rb_tree_test.cpp',
     'tests/register_allocate_test.cpp',
diff --git a/src/util/ralloc.c b/src/util/ralloc.c
index a21c491..11a6c57 100644
--- a/src/util/ralloc.c
+++ b/src/util/ralloc.c
@@ -23,6 +23,7 @@
 
 #include <assert.h>
 #include <stdarg.h>
+#include <stddef.h>
 #include <stdint.h>
 #include <stdio.h>
 #include <stdlib.h>
@@ -30,6 +31,7 @@
 
 #include "util/list.h"
 #include "util/macros.h"
+#include "util/os_memory.h"
 #include "util/u_math.h"
 #include "util/u_overflow.h"
 #include "util/u_printf.h"
@@ -56,9 +58,14 @@ struct ralloc_header
 #ifndef NDEBUG
    /* A canary value used to determine whether a pointer is ralloc'd. */
    unsigned canary;
-   unsigned size;
 #endif
 
+   /* The payload size. resize() needs it where it cannot use realloc(); see
+    * MALLOC_ALIGNS_HEADER. It fills padding the header has anyway, so it
+    * does not make the header bigger on 32- or 64-bit targets.
+    */
+   unsigned size;
+
    struct ralloc_header *parent;
 
    /* The first child (head of a linked list) */
@@ -87,6 +94,14 @@ get_header(const void *ptr)
 
 #define PTR_FROM_HEADER(info) (((char *) info) + sizeof(ralloc_header))
 
+/* C11 only promises that malloc() returns memory aligned for max_align_t.
+ * Where that is less than the header's alignment (on m68k it is 2), blocks
+ * come from os_malloc_aligned() instead, and resize() allocates, copies and
+ * frees rather than calling realloc(). Everywhere else this is a constant
+ * true and the aligned path compiles away.
+ */
+#define MALLOC_ALIGNS_HEADER (alignof(max_align_t) >= alignof(ralloc_header))
+
 /* The size of the block holding a header and a payload of the given size,
  * or 0 if that does not fit in a size_t.
  */
@@ -95,6 +110,12 @@ block_size(size_t size)
 {
    size_t total;
 
+   /* The aligned path copies header->size bytes on resize, so the size has
+    * to be representable there.
+    */
+   if (!MALLOC_ALIGNS_HEADER && size != (unsigned) size)
+      return 0;
+
    if (util_add_overflow(size_t, size,
                          sizeof(ralloc_header) + alignof(ralloc_header) - 1,
                          &total))
@@ -103,6 +124,24 @@ block_size(size_t size)
    return total & ~(alignof(ralloc_header) - 1);
 }
 
+static ralloc_header *
+block_alloc(size_t total)
+{
+   if (MALLOC_ALIGNS_HEADER)
+      return (ralloc_header *) malloc(total);
+
+   return (ralloc_header *) os_malloc_aligned(total, alignof(ralloc_header));
+}
+
+static void
+block_free(ralloc_header *info)
+{
+   if (MALLOC_ALIGNS_HEADER)
+      free(info);
+   else
+      os_free_aligned(info);
+}
+
 static void
 add_child(ralloc_header *parent, ralloc_header *info)
 {
@@ -133,7 +172,7 @@ ralloc_size(const void *ctx, size_t size)
     *    not 16 bytes, are only required to have at least 8 byte alignment.
     */
    size_t total = block_size(size);
-   void *block = likely(total != 0) ? malloc(total) : NULL;
+   void *block = likely(total != 0) ? block_alloc(total) : NULL;
    ralloc_header *info;
    ralloc_header *parent;
 
@@ -150,6 +189,7 @@ ralloc_size(const void *ctx, size_t size)
    info->prev = NULL;
    info->next = NULL;
    info->destructor = NULL;
+   info->size = size;
 
    parent = ctx != NULL ? get_header(ctx) : NULL;
 
@@ -157,7 +197,6 @@ ralloc_size(const void *ctx, size_t size)
 
 #ifndef NDEBUG
    info->canary = CANARY;
-   info->size = size;
 #endif
 
    return PTR_FROM_HEADER(info);
@@ -185,11 +224,24 @@ resize(void *ptr, size_t size)
       return NULL;
 
    old = get_header(ptr);
-   info = realloc(old, total);
+
+   if (MALLOC_ALIGNS_HEADER) {
+      info = realloc(old, total);
+   } else {
+      /* The aligned allocator has no realloc() that keeps the old block
+       * when it fails, so copy by hand and free the old block only once
+       * the links below no longer point at it.
+       */
+      info = block_alloc(total);
+      if (info != NULL)
+         memcpy(info, old, sizeof(ralloc_header) + MIN2(old->size, size));
+   }
 
    if (info == NULL)
       return NULL;
 
+   info->size = size;
+
    /* Update parent and sibling's links to the reallocated node. */
    if (info != old && info->parent != NULL) {
       if (info->parent->child == old)
@@ -206,6 +258,9 @@ resize(void *ptr, size_t size)
    for (child = info->child; child != NULL; child = child->next)
       child->parent = info;
 
+   if (!MALLOC_ALIGNS_HEADER)
+      block_free(old);
+
    return PTR_FROM_HEADER(info);
 }
 
@@ -343,7 +398,7 @@ unsafe_free(ralloc_header *info)
    if (info->destructor != NULL)
       info->destructor(PTR_FROM_HEADER(info));
 
-   free(info);
+   block_free(info);
 }
 
 void
diff --git a/src/util/tests/ralloc_test.cpp b/src/util/tests/ralloc_test.cpp
new file mode 100644
index 0000000..bbaf46d
--- /dev/null
+++ b/src/util/tests/ralloc_test.cpp
@@ -0,0 +1,167 @@
+/*
+ * Copyright © 2026 Jaime Dias
+ * SPDX-License-Identifier: MIT
+ */
+
+#include <stdint.h>
+#include <string.h>
+
+#include <gtest/gtest.h>
+#include "util/ralloc.h"
+
+/* What ralloc promises its callers: the alignment of the header, which is
+ * what malloc() gives on glibc.
+ */
+static const uintptr_t payload_align = sizeof(void *) == 8 ? 16 : 8;
+
+static bool
+aligned(const void *p)
+{
+   return ((uintptr_t) p & (payload_align - 1)) == 0;
+}
+
+static void
+fill(void *p, size_t size, unsigned seed)
+{
+   for (size_t i = 0; i < size; i++)
+      ((unsigned char *) p)[i] = (unsigned char) (seed + i);
+}
+
+static bool
+check(const void *p, size_t size, unsigned seed)
+{
+   for (size_t i = 0; i < size; i++) {
+      if (((const unsigned char *) p)[i] != (unsigned char) (seed + i))
+         return false;
+   }
+   return true;
+}
+
+TEST(Ralloc, PayloadIsAligned)
+{
+   void *ctx = ralloc_context(NULL);
+   ASSERT_TRUE(aligned(ctx));
+
+   for (size_t size = 0; size < 256; size++) {
+      void *p = ralloc_size(ctx, size);
+      ASSERT_NE(p, nullptr);
+      EXPECT_TRUE(aligned(p)) << "size " << size;
+
+      p = reralloc_size(ctx, p, size * 3 + 1);
+      ASSERT_NE(p, nullptr);
+      EXPECT_TRUE(aligned(p)) << "resized from " << size;
+   }
+
+   ralloc_free(ctx);
+}
+
+TEST(Ralloc, ResizeKeepsContents)
+{
+   void *ctx = ralloc_context(NULL);
+   void *p = ralloc_size(ctx, 16);
+   fill(p, 16, 1);
+
+   /* Grow far enough that the block has to move. */
+   p = reralloc_size(ctx, p, 1 << 16);
+   ASSERT_NE(p, nullptr);
+   EXPECT_TRUE(check(p, 16, 1));
+
+   fill(p, 1 << 16, 2);
+   p = reralloc_size(ctx, p, 7);
+   ASSERT_NE(p, nullptr);
+   EXPECT_TRUE(check(p, 7, 2));
+
+   p = reralloc_size(ctx, p, 0);
+   ASSERT_NE(p, nullptr);
+   EXPECT_EQ(ralloc_parent(p), ctx);
+
+   ralloc_free(ctx);
+}
+
+static unsigned destroyed;
+
+static void
+count_destructor(void *)
+{
+   destroyed++;
+}
+
+TEST(Ralloc, ResizeKeepsTheTree)
+{
+   void *ctx = ralloc_context(NULL);
+   void *first = ralloc_size(ctx, 8);
+   void *middle = ralloc_size(ctx, 8);
+   void *last = ralloc_size(ctx, 8);
+   void *grandchild[3];
+
+   for (unsigned i = 0; i < 3; i++) {
+      grandchild[i] = ralloc_size(middle, 8);
+      ralloc_set_destructor(grandchild[i], count_destructor);
+   }
+   ralloc_set_destructor(first, count_destructor);
+   ralloc_set_destructor(middle, count_destructor);
+   ralloc_set_destructor(last, count_destructor);
+
+   /* Move the middle sibling, which has siblings on both sides and
+    * children of its own, a few times over.
+    */
+   for (size_t size = 64; size <= (1 << 18); size *= 4) {
+      middle = reralloc_size(ctx, middle, size);
+      ASSERT_NE(middle, nullptr);
+      EXPECT_EQ(ralloc_parent(middle), ctx);
+      for (unsigned i = 0; i < 3; i++)
+         EXPECT_EQ(ralloc_parent(grandchild[i]), middle);
+   }
+
+   /* The siblings are still linked: stealing one away and freeing the rest
+    * reaches every block exactly once.
+    */
+   void *other = ralloc_context(NULL);
+   ralloc_steal(other, first);
+   EXPECT_EQ(ralloc_parent(first), other);
+
+   destroyed = 0;
+   ralloc_free(ctx);
+   EXPECT_EQ(destroyed, 5u);
+
+   ralloc_free(other);
+   EXPECT_EQ(destroyed, 6u);
+}
+
+TEST(Ralloc, OversizedRequestsFail)
+{
+   void *ctx = ralloc_context(NULL);
+   void *p = ralloc_size(ctx, 32);
+   fill(p, 32, 3);
+
+   EXPECT_EQ(ralloc_size(ctx, SIZE_MAX), nullptr);
+   EXPECT_EQ(ralloc_size(ctx, SIZE_MAX - 4), nullptr);
+
+   /* A failed resize leaves the block as it was. */
+   EXPECT_EQ(reralloc_size(ctx, p, SIZE_MAX), nullptr);
+   EXPECT_TRUE(check(p, 32, 3));
+   EXPECT_EQ(ralloc_parent(p), ctx);
+
+   ralloc_free(ctx);
+}
+
+#ifndef NDEBUG
+TEST(Ralloc, TotalSizeFollowsResize)
+{
+   void *ctx = ralloc_context(NULL);
+   size_t empty = ralloc_total_size(ctx);
+   void *p = ralloc_size(ctx, 16);
+   size_t small = ralloc_total_size(ctx);
+
+   p = reralloc_size(ctx, p, 4096);
+   ASSERT_NE(p, nullptr);
+   EXPECT_GE(ralloc_total_size(ctx), small - 16 + 4096);
+
+   p = reralloc_size(ctx, p, 16);
+   ASSERT_NE(p, nullptr);
+   EXPECT_EQ(ralloc_total_size(ctx), small);
+   EXPECT_GT(small, empty);
+
+   ralloc_free(ctx);
+}
+#endif
-- 
