+static int is_system_memory(uint64_t address, int access_size)
+{
+    for (const struct MemoryBlock *block = sys_memory;
+         block && block->mb_Size; block++) {
+        if (address >= block->mb_Base) {
+            uint64_t offset = address - block->mb_Base;
+            if (offset < block->mb_Size &&
+                (uint64_t)access_size <= block->mb_Size - offset)
+                return 1;
+        }
+    }
+
+    return 0;
+}
