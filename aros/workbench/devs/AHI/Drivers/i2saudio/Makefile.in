#
#  Makefile.in for the Bellatrix I2S Audio AHI audio driver
#
#  Copied from AHI's RPiI2S, which is built for arm and aarch64 only, and
#  ported to m68k-emu68. See patches/aros/0054 for why the upstream drivers
#  keep their filter and ours is a separate directory.
#

VPATH		= @srcdir@

srcdir		= @srcdir@

DRIVER		= i2saudio.audio
MODEFILE	= I2SAUDIO

OBJECTS		= rpii2s-init.o rpii2s-main.o rpii2s-playslave.o rpii2s-accel.o rpii2s-hwaccess.o

include ../Common/Makefile.common
