diff -ruN mesa-26.0.0/src/gallium/auxiliary/cso_cache/cso_cache.h mesa-26.0.0.aros/src/gallium/auxiliary/cso_cache/cso_cache.h
--- mesa-26.0.0/src/gallium/auxiliary/cso_cache/cso_cache.h	2026-10-24 14:42:02.821140085 -0300
+++ mesa-26.0.0.aros/src/gallium/auxiliary/cso_cache/cso_cache.h	2026-10-24 14:42:02.843369524 -0300
@@ -182,11 +182,17 @@
    const unsigned *ikey = (const unsigned *)key;
    unsigned num_elements = key_size / 4;
 
-   assert(key_size % 4 == 0);
-
+   /* AROS: not every key is a whole number of words. On the m68k ABI
+    * structures align to two bytes, and the compact blend key comes out
+    * two bytes short of a multiple of four. Fold the tail in rather than
+    * assert on it. */
    for (unsigned i = 0; i < num_elements; i++)
       hash ^= ikey[i];
 
+   const unsigned char *tail = (const unsigned char *)key + num_elements * 4;
+   for (unsigned i = 0; i < (unsigned)key_size % 4; i++)
+      hash ^= (unsigned)tail[i] << (8 * i);
+
    return hash;
 }
 
