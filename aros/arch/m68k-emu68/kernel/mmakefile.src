include $(SRCDIR)/config/aros.cfg

%set_archincludes mainmmake=kernel-kernel maindir=rom/kernel \
  modname=kernel pri=0 arch=emu68-m68k \
  includes="-I$(SRCDIR)/$(CURDIR)"

%get_archincludes modname=kernel \
    includeflag=TARGET_KERNEL_INCLUDES maindir=rom/kernel

%get_archincludes modname=exec \
    includeflag=TARGET_EXEC_INCLUDES maindir=rom/exec

PRIV_KERNEL_INCLUDES = \
    $(TARGET_KERNEL_INCLUDES) \
    -I$(SRCDIR)/rom/kernel \
    $(TARGET_EXEC_INCLUDES) \
    -I$(SRCDIR)/rom/exec

FILES := cause cli sti schedule kernel_debug getsystemattr context \
         kernel_cpu backtracefromframe

# arch/m68k-emu68/boot for boot.h: getsystemattr.c republishes the framebuffer
# Emu68 handed over as KATTR_FrameBuffer and friends, and that lives in
# emu68_boot_context. hidd/emu68gfx does the same thing for the same reason.
USER_INCLUDES := $(PRIV_KERNEL_INCLUDES) \
    -I$(SRCDIR)/arch/m68k-emu68/boot \
    -I$(GENINCDIR) -I$(AROS_DEVELOPER)/include
USER_CFLAGS := -Os

%build_archspecific \
  mainmmake=kernel-kernel modname=kernel maindir=rom/kernel arch=emu68-m68k \
  files="$(FILES)" compiler=kernel
