include $(SRCDIR)/config/aros.cfg

# The engine is here now, not patched into place from arch/arm-native.
#
# It arrived as that driver and is being replaced file by file by the
# dwc2emu68_* sources beside it (ISSUE-0047); until that finishes both sets
# live here, and the usb2otg_* names are kept precisely so it stays obvious
# which half is still inherited. What changed is only where they are: a patch
# series is the wrong shape for code under active repair, which is what the
# graphics drivers already demonstrated -- ten patches, each needing to be
# regenerated whenever a neighbouring hunk moved, and one silently lost to a
# pin refresh.
#
# The ARM-instruction fixes that used to be patches/aros/0054 are in these
# copies.
DWC2EMU68DIR := $(SRCDIR)/arch/m68k-emu68/soc/usb/dwc2emu68
USB2OTGDIR := $(DWC2EMU68DIR)

USER_INCLUDES := -I$(USB2OTGDIR) -I$(SRCDIR)/arch/m68k-emu68/include
USER_CFLAGS := -Dusb2otg=dwc2emu68

FILES := $(addprefix $(USB2OTGDIR)/, \
    usb2otg_device \
    usb2otg_core \
    usb2otg_intr \
    usb2otg_hub \
    usb2otg_schedule)

%build_module mmake=kernel-usb-dwc2emu68 \
    modname=dwc2emu68 modtype=device \
    conffile=$(DWC2EMU68DIR)/dwc2emu68.conf \
    moduledir=Devs/USBHardware \
    files="$(FILES)" \
    uselibs="hiddstubs debug"

%common
