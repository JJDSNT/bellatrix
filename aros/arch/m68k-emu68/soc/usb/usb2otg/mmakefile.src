include $(SRCDIR)/config/aros.cfg

#
# The BCM2708 USB OTG host controller, built from arch/arm-native's source.
#
# The 9200 lines of driver are not copied here and not patched into a shared
# location: they are compiled in place, from where they live. config/make.tmpl's
# rule_compile_multi resolves a basename that is an absolute path against its own
# directory -- `$(if $(filter /%,$(dir)),$(dir),...)` -- and adds a `vpath %.c`
# for it, so naming the files with $(SRCDIR) in front is all it takes. There is
# exactly one copy of this driver in the tree and it stays upstream's.
#
# What is *not* upstream's is the CPU layer underneath it. rd32le()/wr32le() call
# dmb() on every register access, and that comes from
# arch/arm-all/include/asm/cpu.h, which arch/m68k-all has no counterpart for.
# This target supplies one, in include/asm/cpu.h. See
# AI_context/issues/ISSUE-0019.md.
#
USB2OTGDIR := $(SRCDIR)/arch/arm-native/soc/broadcom/2708/usb/usb2otg

#
# -I$(USB2OTGDIR) is what makes the driver's own `#include "usb2otg_intern.h"`
# resolve, since the compile happens with CURDIR set to this directory rather
# than to the source's. -I this target's include/ brings in <asm/cpu.h> and
# <hardware/videocore.h>, both of which the driver reaches for.
#
USER_INCLUDES := -I$(USB2OTGDIR) -I$(SRCDIR)/arch/m68k-emu68/include

FILES := $(addprefix $(USB2OTGDIR)/, \
    usb2otg_device \
    usb2otg_core \
    usb2otg_intr \
    usb2otg_hub \
    usb2otg_schedule)

#
# Devs/USBHardware is where Poseidon looks for host-controller drivers, so this
# is a file on the card rather than something linked into the kernel ELF. It
# therefore only appears in a `build-aros.sh full` build.
#
%build_module mmake=kernel-usb-usb2otg-emu68 \
    modname=usb2otg modtype=device \
    conffile=$(USB2OTGDIR)/usb2otg.conf \
    moduledir=Devs/USBHardware \
    files="$(FILES)" \
    uselibs="hiddstubs debug"

%common
