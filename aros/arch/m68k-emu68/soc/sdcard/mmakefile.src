include $(SRCDIR)/config/aros.cfg

# rom/devs/sdcard is the generic skeleton and is built unmodified. This
# directory supplies only the board-specific half, attached through the
# %build_archspecific seam -- the same way
# arch/arm-native/soc/broadcom/2708/sdcard does for its targets.
#
# proto/mbox.h is generated by the mbox module, so that has to be built first,
# and the SDHOST backend opens dma.resource, so proto/dma.h needs the same.
#MM- kernel-sdcard : kernel-mbox-emu68 kernel-dma-emu68 kernel-sdcard-emu68-m68k

# The two lines above and below are load-bearing, and neither is emitted for
# us. config/make.tmpl:3262-3277 shows %build_archspecific declaring only
#
#     #MM %(mainmmake)-%(arch) : %(mainmmake)-%(arch)-includes
#
# and nothing that makes %(mainmmake) itself depend on it. Meanwhile the lean
# build does not ask for kernel-sdcard at all -- boot/mmakefile.src asks for
# kernel-sdcard-kobj.
#
# The module links whatever object files happen to exist in the arch/ objdir,
# so a missing dependency here does not fail loudly. It shows up as undefined
# symbols at the ELF link if you are lucky, and as the *previous* backend
# still running if you are not -- you then measure the controller you thought
# you replaced. This port has paid for that shape of mistake before.
#MM- kernel-sdcard-kobj : kernel-sdcard-emu68-m68k
#MM- kernel-sdcard-kobj-quick : kernel-sdcard-emu68-m68k-quick

#
# arch/arm-native's include/ is last on purpose, and which -I wins matters.
# Its *sdcard* directory is no longer on the list at all: every local include
# in this backend resolves either here or in rom/devs/sdcard, and leaving the
# original's directory reachable would mean a header could still be picked up
# from it without anyone noticing which copy was compiled.
#
# That directory holds a bcm2708.h, a videocore.h and an arasan.h, and this
# port has its own with the same names -- see the note at the top of
# include/hardware/bcm2708.h, which is why it was kept off the include path
# until now. Ours comes first, so ours wins for those three. What the
# arm-native directory is here for is the two headers we have no counterpart
# to and no reason to copy: <hardware/sdhost.h> (the SDHOST register map) and
# <hardware/bcm2708_dma.h> (the control-block layout and the DMACHF_* flags).
#
USER_INCLUDES := -I$(SRCDIR)/$(CURDIR) \
                 -I$(SRCDIR)/rom/devs/sdcard \
                 -I$(SRCDIR)/arch/m68k-emu68/include \
                 -I$(SRCDIR)/arch/arm-native/soc/broadcom/2708/include

# -fno-common: Emu68's ELF loader rejects the whole guest image on the first
# COMMON symbol (src/ElfLoader.c bails on SHN_COMMON), and this backend has
# tentative definitions such as "APTR MBoxBase;".
USER_CFLAGS := -fno-common

#
# Which controller owns the card slot. One or the other -- this is a BCM2837,
# both controllers exist on it, and each backend registers itself with
# ADD2INITLIB at SDCARD_BUSINITPRIO, so building both would have two drivers
# claiming the same slot.
#
#   arasan  the Arasan SDHCI at peripheral offset 0x300000, pure PIO. What
#           bring-up used, and what every boot before 2026-08-17 ran on.
#   sdhost  the Broadcom SDHOST at 0x202000, DMA through dma.resource. The
#           target configuration: it frees the Arasan for SDIO, which is the
#           only way WiFi can ever work on this board -- AROS's own
#           sdio.resource is bound to the Arasan by name. See
#           AI_context/issues/ISSUE-0013.md.
#
# Kept as a switch rather than a replacement because the two are directly
# comparable: patches/aros/0024 reports what the data path costs on either,
# and a boot that will not come up on one has to be answerable against the
# other without a bisect.
#
# Edited here rather than passed in. mmake does not forward a variable to the
# sub-make it spawns for a directory -- neither from the environment nor from
# its own command line -- so `make SDCARD_BACKEND=... ` silently builds the
# default. Changing the line below is the interface.
#
# QEMU's raspi3b emulates both, plus bcm2835-dma and the GPIO mux that decides
# which controller the card is wired to, so this is testable here.
#
SDCARD_BACKEND := sdhost

# The SDHOST sources are ours now.
#
# They used to be three-line files that #included the arm-native original,
# because %build_archspecific cannot name a file outside its own directory and
# a relative path cannot escape a symlinked tree either. That worked, and it
# meant every change to this driver had to be a patch against somebody else's
# file -- for a driver this port depends on to boot, on hardware upstream does
# not target, in a failure mode upstream has never seen.
#
# So they were copied here, the way vcgfx, fbgfx and the DWC2 engine were, and
# patches/aros/0027 folded in with them. There is one copy and it is this one.
#
# sdcard_bcm2708time stays ours for a different reason: it is the Emu68
# specific delay loop, and the JIT folding `nop` is why it is written the way
# it is.
#
# emu68sd is the third choice, and it is a second driver rather than a mode of
# the first. It implements the same eleven bus functions against the same
# controller and answers the same questions differently: no DMA channel, no
# bounce buffer, no cache maintenance, and the FIFO drained by the CPU in
# bursts -- which is what Emu68's own brcm-sdhc.device does on this hardware.
#
# Two drivers, so sdcard.md's matrix has something to compare. One driver with
# a switch inside it would not.
#
ifeq ($(SDCARD_BACKEND),emu68sd)
BCM2708FILES = \
    sdcard_emu68sd_init \
    sdcard_emu68sd_bus \
    sdcard_bcm2708time
else ifeq ($(SDCARD_BACKEND),sdhost)
BCM2708FILES = \
    sdcard_sdhost_init \
    sdcard_sdhost_bus \
    sdcard_bcm2708time
else
BCM2708FILES = \
    sdcard_bcm2708init \
    sdcard_bcm2708bus \
    sdcard_bcm2708time
endif

%build_archspecific \
  mainmmake=kernel-sdcard maindir=rom/devs/sdcard \
  arch=emu68-m68k modname=sdcard \
  files="$(BCM2708FILES)"

%common
