include $(SRCDIR)/config/aros.cfg

#MM kernel-m68k-emu68-fbgfx-kobj : kernel-hidd-gfx-includes

#
# The boot display driver. Started as arch/aarch64-raspi's framebuffer HIDD and
# is ours now, for the same reason vcgfx is: it is code we change, and a patch
# series is the wrong shape for that.
#
# It is the DDRV_BootMode driver -- the one in the kickstart that gives the
# machine something to draw on before any filesystem exists, and that
# graphics.library retires when a native driver claims the hardware.
#
# What that driver needs from us is only KrnGetSystemAttr(KATTR_FrameBuffer*),
# which kernel/getsystemattr.c now answers -- initFBGfxHW() does nothing else
# to find its surface.
#
FBGFXDIR := $(SRCDIR)/$(CURDIR)

FILES := \
    $(FBGFXDIR)/fbgfx_init \
    $(FBGFXDIR)/fbgfx_hiddclass \
    $(FBGFXDIR)/fbgfx_displayclass \
    $(FBGFXDIR)/fbgfx_support \
    $(FBGFXDIR)/fbgfx_bitmapclass

# arch/m68k-emu68/boot for bootui_api.h: the display class registers the
# callback that puts the finished screen up.
USER_INCLUDES := -I$(FBGFXDIR) -I$(SRCDIR)/arch/m68k-emu68/boot
USER_CPPFLAGS := -D__OOP_NOATTRBASES__ -D__EMU68__

%build_module mmake=kernel-m68k-emu68-fbgfx \
  modname=fbgfx modtype=hidd \
  conffile=$(FBGFXDIR)/fbgfx.conf \
  files="$(FILES)"

%common
