include $(SRCDIR)/config/aros.cfg

#
# The SoC descriptions, published as <hardware/videocore.h> and
# <hardware/arasan.h>.
#
# They sit inside soc/ rather than in the architecture's include/ because that
# is where the hardware they describe is driven, and because it is what upstream
# does: arch/arm-native/soc/broadcom/2708/include/hardware holds videocore.h and
# arasan.h under those exact names. A second SoC would bring its own directory
# beside this one rather than adding files to a shared pile.
#
# See ../../include/mmakefile.src for why the hook is named after the machine.
#
INCLUDE_FILES := $(call WILDCARD, hardware/*.[hi])

#MM- includes-copy-emu68-m68k : includes-common-m68k

%copy_includes mmake=includes-copy-emu68-m68k
