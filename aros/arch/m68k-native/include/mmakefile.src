include $(SRCDIR)/config/aros.cfg

#
# Publish the port's own headers into $(GENINCDIR), so they are reachable as
# <aros/bootcontract.h> and <asm/cpu.h> without every mmakefile adding an -I.
#
# The hook name is the machine's. compiler/include/mmakefile.src:88 pulls
# includes-copy-$(ARCH)-$(CPU) into includes-copy, and there is no second key
# available to us -- $(FAMILY) is empty for any non-hosted target, and there is
# no "native" key anywhere in the selection chain (see ISSUE-0023). So this and
# arch/m68k-emu68/include both hook the same target name, which mmake runs in
# each directory that declares it, exactly as three directories share
# kernel-kernel-emu68-m68k.
#
# aros/ holds bootcontract.h, the port's requirements on whatever starts it, and
# bootstruct.h, which exists only to unblock the inherited Amiga command set --
# see the comment in that file. asm/ holds the CPU primitives arm-native drivers
# reach for through <asm/cpu.h>, which arch/m68k-all does not provide; it is here
# rather than in arch/m68k-all/include because that directory is upstream's and
# also serves m68k-amiga.
#
# The SoC descriptions are deliberately not here. They live with the drivers, in
# ../soc/include/hardware, the way arm-native keeps its own under
# soc/broadcom/2708/include.
#
INCLUDE_FILES := $(call WILDCARD, *.[hi] aros/*.[hi] asm/*.[hi])

#MM- includes-copy-emu68-m68k : includes-common-m68k

%copy_includes mmake=includes-copy-emu68-m68k
